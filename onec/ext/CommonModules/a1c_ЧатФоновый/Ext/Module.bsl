#Область ПрограммныйИнтерфейс

// Точка входа фонового задания (ФоновыеЗадания.Выполнить требует метод общего
// модуля — вызов из модуля формы платформа отклоняет).
// Возвращает структуру результата; платформа сама кладёт её во временное
// хранилище, адрес доступен как ФоновоеЗадание.АдресРезультата.
Функция ВыполнитьЗапрос(Знач ТекстПромпта, Знач АдресБэкенда, Знач ИмяПользователяСтрокой = "1c_user", Знач ИдентификаторСессииВходящий = 0, Знач РазмерКонтекстаВходящий = 5, Знач СкилСтрокой = "") Экспорт

	Адрес = СокрЛП(АдресБэкенда);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "http://localhost:8000";
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресБэкенда(Адрес);

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("message", ТекстПромпта);
	ТелоЗапроса.Вставить("user_id", ИмяПользователяСтрокой);
	ТелоЗапроса.Вставить("base_name", ИмяИнформационнойБазы());
	Если ИдентификаторСессииВходящий > 0 Тогда
		ТелоЗапроса.Вставить("session_id", ИдентификаторСессииВходящий);
	КонецЕсли;
	ТелоЗапроса.Вставить("context_size", РазмерКонтекстаВходящий);
	Если ЗначениеЗаполнено(СкилСтрокой) Тогда
		ТелоЗапроса.Вставить("skill", СкилСтрокой);
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	Запрос = Новый HTTPЗапрос("/chat", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);

	Если ПараметрыАдреса.Защищенное Тогда
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, , , , 300);
	КонецЕсли;

	Попытка
		ОтветHTTP = Соединение.ОтправитьДляОбработки(Запрос);
		ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если ОтветHTTP.КодСостояния <> 200 Тогда
			Возврат НовыйРезультат(Истина, СтрШаблон(НСтр("ru = 'Бэкенд HTTP %1'"), ОтветHTTP.КодСостояния), "");
		КонецЕсли;

		РезультатФона = НовыйРезультат(Ложь, "", ИзвлечьОтветИзSSE(ТелоОтвета));
		// session_id из done, чтобы следующий вопрос шёл в ту же сессию.
		Попытка
			Мета = ИзвлечьМетаИзSSE(ТелоОтвета);
			Если Мета <> Неопределено И Мета.Свойство("session_id") Тогда
				РезультатФона.Вставить("ИдентификаторСессии", Мета.session_id);
			КонецЕсли;
		Исключение
		КонецПопытки;
		Возврат РезультатФона;
	Исключение
		Возврат НовыйРезультат(Истина, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), "");
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область ИмяБазы

// Имя ИБ (НРег) для мультибазовости: уходит в base_name каждого POST /chat.
Функция ИмяИнформационнойБазы() Экспорт
	// 1. Через БСП, если подсистема есть в конфигурации.
	Если Метаданные.ОбщиеМодули.Найти("СтроковыеФункцииКлиентСервер") <> Неопределено Тогда
		Попытка
			Параметры = СтроковыеФункцииКлиентСервер.ПараметрыИзСтроки(СтрокаСоединенияИнформационнойБазы());
			Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("Ref")
				И ЗначениеЗаполнено(Параметры.Ref) Тогда
				Возврат НРег(Параметры.Ref);
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
	// 2. Ручной разбор без зависимостей.
	Возврат ИмяБазыИзСтрокиСоединения(СтрокаСоединенияИнформационнойБазы());
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультат(ЭтоОшибка, ТекстОшибки, ТекстОтвета)

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", ЭтоОшибка);
	Результат.Вставить("ТекстОшибки", ТекстОшибки);
	Результат.Вставить("ТекстОтвета", ТекстОтвета);
	Результат.Вставить("ВсегоТокенов", 0);
	Результат.Вставить("ВремяОтветаСекунд", 0);
	Результат.Вставить("МодельОтвета", "");
	Результат.Вставить("ВложенияОтвета", Новый Массив);
	Результат.Вставить("ИдентификаторСессии", 0);
	Возврат Результат;

КонецФункции

Функция ИзвлечьМетаИзSSE(Знач ТелоSSE)

	Строки = СтрРазделить(ТелоSSE, Символы.ПС, Ложь);
	Для Каждого Стр Из Строки Цикл
		С = СокрЛП(Стр);
		Если СтрНачинаетсяС(С, "data:") Тогда
			JSONСтр = СокрЛП(Сред(С, 6));
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(JSONСтр);
				Данные = ПрочитатьJSON(Чтение);
				Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("session_id") Тогда
					Возврат Данные;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

Функция ИмяБазыИзСтрокиСоединения(Знач СтрокаСоединения)
	// Серверный вариант: Srvr="...";Ref="имя";
	Позиция = СтрНайти(СтрокаСоединения, "Ref=""");
	Если Позиция > 0 Тогда
		Остаток = Сред(СтрокаСоединения, Позиция + 5);
		ПозицияКавычки = СтрНайти(Остаток, """");
		Если ПозицияКавычки > 1 Тогда
			Возврат НРег(Лев(Остаток, ПозицияКавычки - 1));
		КонецЕсли;
		Возврат "unknown";
	КонецЕсли;
	// Файловый вариант: File="путь" — берём имя каталога.
	Позиция = СтрНайти(СтрокаСоединения, "File=""");
	Если Позиция > 0 Тогда
		Остаток = Сред(СтрокаСоединения, Позиция + 6);
		ПозицияКавычки = СтрНайти(Остаток, """");
		Если ПозицияКавычки > 1 Тогда
			Путь = Лев(Остаток, ПозицияКавычки - 1);
		Иначе
			Путь = Остаток;
		КонецЕсли;
		Путь = СтрЗаменить(Путь, "/", "\");
		Пока ЗначениеЗаполнено(Путь) И Прав(Путь, 1) = "\" Цикл
			Путь = Лев(Путь, СтрДлина(Путь) - 1);
		КонецЦикла;
		Части = СтрРазделить(Путь, "\", Ложь);
		Если Части.Количество() > 0 Тогда
			Возврат НРег(Части[Части.ВГраница()]);
		КонецЕсли;
	КонецЕсли;
	Возврат "unknown";
КонецФункции

Функция РазобратьАдресБэкенда(Знач Адрес)

	// Поддерживает http://host:port и https://host:port
	Результат = Новый Структура("Сервер, Порт, Защищенное", "localhost", 8000, Ложь);
	Стр = СокрЛП(Адрес);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Стр), "https://") Тогда
		Защищенное = Истина;
		Стр = Сред(Стр, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Стр), "http://") Тогда
		Стр = Сред(Стр, 8);
	КонецЕсли;

	// Отрезать путь
	ПозицияСлэша = СтрНайти(Стр, "/");
	Если ПозицияСлэша > 0 Тогда
		Стр = Лев(Стр, ПозицияСлэша - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Стр, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(Стр, ПозицияДвоеточия - 1);
		ПортСтрокой = Сред(Стр, ПозицияДвоеточия + 1);
		Попытка
			Результат.Порт = Число(ПортСтрокой);
		Исключение
			Результат.Порт = ?(Защищенное, 443, 80);
		КонецПопытки;
	Иначе
		Результат.Сервер = Стр;
		Результат.Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	Результат.Защищенное = Защищенное;

	Возврат Результат;

КонецФункции

Функция ИзвлечьОтветИзSSE(Знач ТелоSSE)

	// Собирает все event: answer -> data.delta
	Результат = "";
	Строки = СтрРазделить(ТелоSSE, Символы.ПС, Ложь);
	Для Каждого Стр Из Строки Цикл
		С = СокрЛП(Стр);
		Если СтрНачинаетсяС(С, "data:") Тогда
			JSONСтр = СокрЛП(Сред(С, 6));
			Если ПустаяСтрока(JSONСтр) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(JSONСтр);
				Данные = ПрочитатьJSON(Чтение);
				Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("delta") Тогда
					Результат = Результат + Данные.delta;
				КонецЕсли;
			Исключение
				// Пропустить битый фрагмент
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// Fallback: если нет SSE, вернуть как есть (обрезанная)
	Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ТелоSSE) Тогда
		// Попытка интерпретировать как JSON {answer}
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТелоSSE);
			Данные = ПрочитатьJSON(Чтение);
			Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("answer") Тогда
				Возврат Данные.answer;
			КонецЕсли;
		Исключение
		КонецПопытки;
		// Вернуть сырое тело (до 4000)
		Возврат Лев(ТелоSSE, 4000);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти
