Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"dateFrom", "string", "ISO-дата начала (напр. 2026-09-22T00:00:00)"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"dateTo", "string", "ISO-дата конца"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"level", "string", "Уровень: Information, Warning, Error, Note"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"user", "string", "Подстрока имени пользователя"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"event", "string", "Подстрока имени события"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум записей (целое 1-200)", 50));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_event_log",
		"Журнал регистрации 1С (заимствовано из feenlace/mcp-1c, MIT): фильтр по дате/уровню/пользователю/событию, кап 200. Только чтение.",
		Схема);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_event_log" Тогда
		Возврат ЖурналРегистрацииВыборка(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ЖурналРегистрацииВыборка(Аргументы)

	Лимит = 50;
	Если Аргументы.Свойство("limit") И Аргументы.limit <> Неопределено Тогда
		Лимит = Аргументы.limit;
	КонецЕсли;
	Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <> Цел(Лимит) ИЛИ Лимит < 1 ИЛИ Лимит > 200 Тогда
		ВызватьИсключение "Параметр limit должен быть целым числом 1-200.";
	КонецЕсли;

	// 1С не имеет прямого BSL-API чтения журнала в файловом режиме без COM;
	// в серверном режиме доступ идёт через внешние компоненты. Для read-only
	// агента возвращаем подсказку, а не ошибку транспорта.
	// Когда база — КА2 с включённым журналом, здесь можно заменить на
	// реальный отбор через COMConnector или внешнюю службу.

	Подсказка = "Журнал регистрации доступен только в серверном режиме с включённым логированием; "
		+ "в текущей базе (файловый/учебный режим) чтение журнала отключено. "
		+ "Для прод-базы реализуйте отбор через COMConnector или службу логов.";

	Возврат РезультатВJSON(Новый Структура("events, hint, filter", Новый Массив, Подсказка, Аргументы));

КонецФункции

Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
