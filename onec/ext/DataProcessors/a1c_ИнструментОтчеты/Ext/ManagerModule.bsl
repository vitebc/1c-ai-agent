Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"report", "string", "Макет отчёта: sales_by_warehouse (продажи по складам) или debtors (дебиторка)", ,
		Истина, "sales_by_warehouse,debtors"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"period", "string", "Период форматом ГГГГ-Q1..Q4 / ГГГГ-H1..H2 / ГГГГ-Y, например 2026-Q1", , Истина));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"warehouse", "string", "Точное наименование склада. Только для sales_by_warehouse."));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум строк в ответе (целое 1-100)", 20));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"run_skd_report",
		"Отчёт по готовому макету КА2: продажи по складам или дебиторская задолженность. Только чтение.",
		Схема);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "run_skd_report" Тогда
		Возврат ОтчетПоМакету(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ОтчетПоМакету(Аргументы)

	Макет = СокрЛП(Аргументы.report);
	Если Макет <> "sales_by_warehouse" И Макет <> "debtors" Тогда
		ВызватьИсключение "Неизвестный макет отчёта: " + Макет
			+ ". Доступны: sales_by_warehouse, debtors.";
	КонецЕсли;

	Период = РазобратьПериод(СокрЛП(Аргументы.period));

	Лимит = ?(Аргументы.Свойство("limit"), Аргументы.limit, 20);
	ПроверитьЛимит(Лимит, "limit");

	Если Макет = "sales_by_warehouse" Тогда
		Возврат ПродажиПоСкладам(Период, Аргументы, Лимит);
	Иначе
		Если Аргументы.Свойство("warehouse") И ЗначениеЗаполнено(СокрЛП(Аргументы.warehouse)) Тогда
			ВызватьИсключение "Макет debtors не фильтруется по складу: уберите параметр warehouse.";
		КонецЕсли;
		Возврат ДебиторскаяЗадолженность(Период, Лимит);
	КонецЕсли;

КонецФункции

// Разбирает "ГГГГ-Q1..Q4 / H1..H2 / Y" в структуру {Начало, Конец} (даты).
Функция РазобратьПериод(СтрокаПериода)

	Части = СтрРазделить(СтрокаПериода, "-", Ложь);
	Если Части.Количество() <> 2 Тогда
		ВызватьИсключение "Период должен быть форматом ГГГГ-Q1..Q4 / ГГГГ-H1..H2 / ГГГГ-Y, например 2026-Q1.";
	КонецЕсли;

	Попытка
		Год = Число(Части[0]);
	Исключение
		ВызватьИсключение "Год в периоде должен быть числом, например 2026-Q1.";
	КонецПопытки;
	Если Год < 2000 ИЛИ Год > 2100 Тогда
		ВызватьИсключение "Год в периоде вне диапазона 2000-2100.";
	КонецЕсли;

	Суффикс = ВРег(СокрЛП(Части[1]));
	ПервыйСимвол = Лев(Суффикс, 1);
	Номер = Число(Сред(Суффикс, 2));
	Если ПервыйСимвол = "Q" И Номер >= 1 И Номер <= 4 Тогда
		МесяцС = (Номер - 1) * 3 + 1;
		МесяцПо = МесяцС + 2;
	ИначеЕсли (ПервыйСимвол = "H" ИЛИ ПервыйСимвол = "П") И (Номер = 1 ИЛИ Номер = 2) Тогда
		// H1/H2 латиницей; П1/П2 (полугодие) кириллицей — на всякий случай.
		МесяцС = ?(Номер = 1, 1, 7);
		МесяцПо = ?(Номер = 1, 6, 12);
	ИначеЕсли Суффикс = "Y" ИЛИ Суффикс = "Г" Тогда
		МесяцС = 1;
		МесяцПо = 12;
	Иначе
		ВызватьИсключение "Период должен быть форматом ГГГГ-Q1..Q4 / ГГГГ-H1..H2 / ГГГГ-Y, например 2026-Q1.";
	КонецЕсли;

	Начало = Дата(Год, МесяцС, 1);
	Конец = КонецМесяца(Дата(Год, МесяцПо, 1));
	Возврат Новый Структура("Начало, Конец", Начало, Конец);

КонецФункции

Процедура ПроверитьЛимит(Лимит, ИмяПараметра)

	Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <> Цел(Лимит) ИЛИ Лимит < 1 ИЛИ Лимит > 100 Тогда
		ВызватьИсключение "Параметр " + ИмяПараметра + " должен быть целым числом 1-100.";
	КонецЕсли;

КонецПроцедуры

Функция ПродажиПоСкладам(Период, Аргументы, Лимит)

	Склад = "";
	Если Аргументы.Свойство("warehouse") Тогда
		Склад = СокрЛП(Аргументы.warehouse);
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Реал.Номенклатура.Наименование КАК Номенклатура,
		|	Реал.Ссылка.Склад.Наименование КАК Склад,
		|	СУММА(Реал.Количество) КАК Количество,
		|	СУММА(Реал.Сумма) КАК Сумма
		|ИЗ
		|	Документ.РеализацияТоваровУслуг.Товары КАК Реал
		|ГДЕ
		|	Реал.Ссылка.Проведен
		|	И Реал.Ссылка.Дата МЕЖДУ &Начало И &Конец";
	Если ЗначениеЗаполнено(Склад) Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	И Реал.Ссылка.Склад.Наименование = &Склад";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
		|СГРУППИРОВАТЬ ПО
		|	Реал.Номенклатура.Наименование,
		|	Реал.Ссылка.Склад.Наименование";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Начало", Период.Начало);
	Запрос.УстановитьПараметр("Конец", Период.Конец);
	Если ЗначениеЗаполнено(Склад) Тогда
		ПроверитьСкладСуществует(Склад);
		Запрос.УстановитьПараметр("Склад", Склад);
	КонецЕсли;

	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();

	Строки = Новый Массив;
	Для Каждого СтрокаТЗ Из ВыборкаТЗ Цикл
		Строки.Добавить(Новый Структура("sku, warehouse, qty, sum",
			СтрокаТЗ.Номенклатура, СтрокаТЗ.Склад, СтрокаТЗ.Количество, СтрокаТЗ.Сумма));
	КонецЦикла;

	Возврат Строки;

КонецФункции

// Проверяет склад по наименованию; в тексте ошибки — доступные склады.
Процедура ПроверитьСкладСуществует(Склад)

	Ссылка = Справочники.Склады.НайтиПоНаименованию(Склад, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 20
		|	Склады.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Склады КАК Склады");
	Доступные = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Доступные.Добавить(Выборка.Наименование);
	КонецЦикла;

	ВызватьИсключение "Склад '" + Склад + "' не найден. Доступные склады: "
		+ СтрСоединить(Доступные, ", ") + ".";

КонецПроцедуры

Функция ДебиторскаяЗадолженность(Период, Лимит)

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Расчеты.Контрагент.Наименование КАК Контрагент,
		|	Расчеты.Контрагент.ИНН КАК ИНН,
		|	Расчеты.СуммаОстаток КАК Долг
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(&Граница, ) КАК Расчеты
		|ГДЕ
		|	Расчеты.СуммаОстаток > 0";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Граница",
		Новый Граница(КонецДня(Период.Конец), ВидГраницы.Включая));

	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();

	Строки = Новый Массив;
	Для Каждого СтрокаТЗ Из ВыборкаТЗ Цикл
		Строки.Добавить(Новый Структура("name, inn, debt",
			СтрокаТЗ.Контрагент, СтрокаТЗ.ИНН, СтрокаТЗ.Долг));
	КонецЦикла;

	Возврат Строки;

КонецФункции

#КонецОбласти
