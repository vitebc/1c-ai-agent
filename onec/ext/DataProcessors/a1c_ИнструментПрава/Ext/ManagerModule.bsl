Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectName", "string", "Имя объекта метаданных (необязательно, напр. Справочник.Контрагенты)"));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"userName", "string", "Имя пользователя или роли (необязательно)"));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_access_rights",
		"Права доступа к объектам метаданных (OneBridge/MIT): чтение/запись/админ/нет.",
		Схема);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_access_rights" Тогда
		Возврат ПраваДоступа(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ПраваДоступа(Аргументы)

	Объект = "";
	Если Аргументы.Свойство("objectName") И ЗначениеЗаполнено(Аргументы.objectName) Тогда
		Объект = СокрЛП(Аргументы.objectName);
	КонецЕсли;

	Пользователь = "";
	Если Аргументы.Свойство("userName") И ЗначениеЗаполнено(Аргументы.userName) Тогда
		Пользователь = СокрЛП(Аргуuments.userName);
	КонецЕсли;

	// В 1С чтение прав доступа требует доступа к ролям и правам.
	// Полный функционал доступен через роли (Metadata.Roles) и проверку прав.
	// Здесь базовый ответ — для прод-баз нужно расширить через COMConnector
	// или анализ ролей пользователя.

	Результат = Новый Структура;
	Результат.Вставить("objectName", ?(ЗначениеЗаполнено(Объект), Объект, "all"));
	Результат.Вставить("userName", ?(ЗначениеЗаполнено(Пользователь), Пользователь, "current"));
	Результат.Вставить("rights", Новый Массив("Read", "Write", "Create", "Delete", "Interactive"));
	Результат.Вставить("isAdmin", Ложь);
	Результат.Вставить("hint", "Базовая реализация. Для точных прав настройте анализ ролей пользователя через COMConnector или сервер 1С.");

	Возврат РезультатВJSON(Результат);

КонецФункции

Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти