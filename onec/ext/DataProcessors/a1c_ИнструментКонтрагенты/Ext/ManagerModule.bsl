Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query", "string", "ИНН (10 или 12 цифр — точный поиск) или подстрока наименования контрагента", , Истина));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_counterparty",
		"Карточка контрагента КА2 (справочник Контрагенты): наименование, ИНН, партнёр, задолженность. Только чтение.",
		Схема);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_counterparty" Тогда
		Возврат КарточкаКонтрагента(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция КарточкаКонтрагента(Аргументы)

	ЗапросСтрока = СокрЛП(Аргументы.query);
	Если НЕ ЗначениеЗаполнено(ЗапросСтрока) Тогда
		ВызватьИсключение "Параметр query пустой: укажите ИНН или подстроку наименования.";
	КонецЕсли;

	ПоискПоИНН = ТолькоЦифры(ЗапросСтрока)
		И (СтрДлина(ЗапросСтрока) = 10 ИЛИ СтрДлина(ЗапросСтрока) = 12);

	Если ПоискПоИНН Тогда
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	Контрагенты.Наименование КАК Наименование,
			|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
			|	Контрагенты.ИНН КАК ИНН,
			|	Контрагенты.Партнер КАК Партнер
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	Контрагенты.ИНН = &ИНН
			|УПОРЯДОЧИТЬ ПО
			|	Контрагенты.Наименование";
	Иначе
		// Нечёткий поиск: разбиваем фразу на слова, ищем ПОДОБНО %слово% по Наименование/НаименованиеПолное (ИЛИ)
		Слова = СтрРазделить(ЗапросСтрока, " ", Ложь);
		ТекстЗапроса =
			"ВЫБРАТЬ ПЕРВЫЕ 5
			|	Контрагенты.Наименование КАК Наименование,
			|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
			|	Контрагенты.ИНН КАК ИНН,
			|	Контрагенты.Партнер КАК Партнер
			|ИЗ
			|	Справочник.Контрагенты КАК Контрагенты
			|ГДЕ
			|	ЛОЖЬ";
		Индекс = 0;
		Для Каждого Слово Из Слова Цикл
			Слово = СокрЛП(Слово);
			Если СтрДлина(Слово) < 2 Тогда
				Продолжить;
			КонецЕсли;
			Индекс = Индекс + 1;
			ТекстЗапроса = ТекстЗапроса + "
			|	ИЛИ Контрагенты.Наименование ПОДОБНО &Шаблон" + Индекс + "
			|	ИЛИ Контрагенты.НаименованиеПолное ПОДОБНО &Шаблон" + Индекс;
		КонецЦикла;
		// Детерминированный порядок: без него ПЕРВЫЕ 5 каждый раз разные.
		Если Индекс > 0 Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО
			|	Контрагенты.Наименование";
		КонецЕсли;
		Если Индекс = 0 Тогда
			ТекстЗапроса =
				"ВЫБРАТЬ ПЕРВЫЕ 5
				|	Контрагенты.Наименование КАК Наименование,
				|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
				|	Контрагенты.ИНН КАК ИНН,
				|	Контрагенты.Партнер КАК Партнер
				|ИЗ
				|	Справочник.Контрагенты КАК Контрагенты
				|ГДЕ
				|	Контрагенты.Наименование ПОДОБНО &Шаблон
				|УПОРЯДОЧИТЬ ПО
				|	Контрагенты.Наименование";
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Если ПоискПоИНН Тогда
		Запрос.УстановитьПараметр("ИНН", ЗапросСтрока);
	ИначеЕсли Индекс > 0 Тогда
		Инд = 0;
		Для Каждого Слово Из Слова Цикл
			Слово = СокрЛП(Слово);
			Если СтрДлина(Слово) < 2 Тогда
				Продолжить;
			КонецЕсли;
			Инд = Инд + 1;
			Запрос.УстановитьПараметр("Шаблон" + Инд, "%" + ЭкранироватьШаблонПодобия(Слово) + "%");
		КонецЦикла;
	Иначе
		Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьШаблонПодобия(ЗапросСтрока) + "%");
	КонецЕсли;

	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();

	// Пустой результат — НЕ ошибка: агент сам сообщит «не найдено».
	Строки = Новый Массив;
	Для Каждого СтрокаТЗ Из ВыборкаТЗ Цикл
		Строки.Добавить(Новый Структура("name, full, inn, debt",
			СтрокаТЗ.Наименование,
			?(ЗначениеЗаполнено(СтрокаТЗ.НаименованиеПолное), СтрокаТЗ.НаименованиеПолное, СтрокаТЗ.Наименование),
			СтрокаТЗ.ИНН,
			ЗадолженностьПартнера(СтрокаТЗ.Партнер)));
	КонецЦикла;

	Возврат РезультатВJSON(Строки);

КонецФункции

Функция ЗадолженностьПартнера(Партнер)

	Если НЕ ЗначениеЗаполнено(Партнер) Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	СУММА(Расчеты.СуммаОстаток) КАК Долг
		|ИЗ
		|	РегистрНакопления.РасчетыСКлиентами.Остатки(&ТекущаяДата, ) КАК Расчеты
		|ГДЕ
		|	Расчеты.АналитикаУчетаПоПартнерам.Партнер = &Партнер");
	Запрос.УстановитьПараметр("Партнер", Партнер);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат ?(ЗначениеЗаполнено(Выборка.Долг), Выборка.Долг, 0);
	КонецЕсли;

	Возврат 0;

КонецФункции

Функция ТолькоЦифры(Строка)

	Если НЕ ЗначениеЗаполнено(Строка) Тогда
		Возврат Ложь;
	КонецЕсли;

	Длина = СтрДлина(Строка);
	Для Н = 1 По Длина Цикл
		Код = КодСимвола(Сред(Строка, Н, 1));
		Если Код < 48 ИЛИ Код > 57 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;

КонецФункции

// Экранирует спецсимволы ПОДОБНО, чтобы ввод искал буквально, а не как маску.
Функция ЭкранироватьШаблонПодобия(Строка)

	Результат = СтрЗаменить(Строка, "%", "[%]");
	Результат = СтрЗаменить(Результат, "_", "[_]");
	Возврат Результат;

КонецФункции

// Сериализует результат в JSON-строку. Движок одиночное значение заворачивает
// в текстовый блок как есть, а структуры/массивы портит через Строка().
Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
