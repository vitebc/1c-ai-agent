Процедура ДобавитьИнструменты(Инструменты) Экспорт

	ПараметрыЗапроса = Новый Массив;
	ПараметрыЗапроса.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query", "string", "Текст запроса. Должен начинаться с ВЫБРАТЬ или SELECT — только чтение.", , Истина));
	ПараметрыЗапроса.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум строк в ответе (целое 1-200)", 50));
	СхемаЗапроса = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыЗапроса);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_select",
		"Универсальный SELECT по данным 1С (Документы, Справочники, Регистры) — только ВЫБРАТЬ/SELECT, кап 200. "
		+ "Параметры (&q) НЕ поддерживаются — только литералы в тексте. "
		+ "Обязательно сверяй имена через list_metadata_objects/get_metadata_structure. "
		+ "Пример: ВЫБРАТЬ Номер, Дата ИЗ Документ.ЗаказКлиента ГДЕ Партнер.Наименование ПОДОБНО ""%Прокудин%"" УПОРЯДОЧИТЬ ПО Дата УБЫВ. Только чтение.",
		СхемаЗапроса);

	// feenlace/mcp-1c (MIT): execute_query с &параметрами — безопасная альтернатива литералам.
	ПараметрыЗапроса2 = Новый Массив;
	ПараметрыЗапроса2.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query", "string", "Текст запроса 1С с &параметрами, напр. ГДЕ Дата >= &ДатаНач", , Истина));
	ПараметрыЗапроса2.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"parameters", "object", "Значения &параметров как структура {Имя: Значение}"));
	ПараметрыЗапроса2.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум строк в ответе (целое 1-200)", 50));
	СхемаЗапроса2 = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыЗапроса2);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"execute_query",
		"Запрос 1С с &параметрами (заимствовано из feenlace/mcp-1c, MIT): ВЫБРАТЬ/SELECT с parameters, кап 200. "
		+ "Пример: ВЫБРАТЬ Номер ИЗ Документ.ЗаказКлиента ГДЕ Дата >= &Д1 с parameters={Д1: '2026-09-18T00:00:00'}. Только чтение.",
		СхемаЗапроса2);

	ПараметрыПроверки = Новый Массив;
	ПараметрыПроверки.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"query", "string", "Текст запроса для проверки.", , Истина));
	ПараметрыПроверки.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"parameters", "object", "Параметры & для проверки"));
	СхемаПроверки = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыПроверки);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"validate_query",
		"Проверка синтаксиса запроса пробным выполнением (ПЕРВЫЕ 1, только чтение). "
		+ "Принимает query и опц. parameters, возвращает вердикт строкой, а не ошибкой.",
		СхемаПроверки);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "execute_select" Тогда
		Возврат ВыполнитьЗапрос(Аргументы);
	ИначеЕсли ИмяИнструмента = "execute_query" Тогда
		Возврат ВыполнитьЗапросСПараметрами(Аргументы);
	ИначеЕсли ИмяИнструмента = "validate_query" Тогда
		Возврат ПроверитьЗапрос(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

// Проверяет, что текст — выборка. В языке запросов 1С модифицирующих
// операторов нет в принципе, поэтому префиксной проверки достаточно.
Процедура ПроверитьТолькоВыборка(ТекстЗапроса)

	Начало = ВРег(СокрЛ(ТекстЗапроса));
	Если НЕ (Лев(Начало, 7) = "ВЫБРАТЬ" ИЛИ Лев(Начало, 6) = "SELECT") Тогда
		ВызватьИсключение "Разрешены только запросы ВЫБРАТЬ/SELECT. Изменения данных запрещены.";
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьЛимит(Лимит, ИмяПараметра, Максимум)

	Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <> Цел(Лимит) ИЛИ Лимит < 1 ИЛИ Лимит > Максимум Тогда
		ВызватьИсключение "Параметр " + ИмяПараметра + " должен быть целым числом 1-"
			+ Формат(Максимум, "ЧГ=0") + ".";
	КонецЕсли;

КонецПроцедуры

Функция ВыполнитьЗапрос(Аргументы)

	ТекстЗапроса = СокрЛП(Аргументы.query);
	ПроверитьТолькоВыборка(ТекстЗапроса);

	Лимит = ?(Аргументы.Свойство("limit"), Аргументы.limit, 50);
	ПроверитьЛимит(Лимит, "limit", 200);

	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		УстановитьПараметрыЗапроса(Запрос, Аргументы);
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка запроса: " + ОписаниеОшибки();
	КонецПопытки;

	Колонки = РезультатЗапроса.Колонки;
	Выборка = РезультатЗапроса.Выбрать();

	Строки = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > Лимит Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.Имя, ЗначениеВJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;

	Возврат РезультатВJSON(Новый Структура("rows, truncated", Строки, Счетчик > Лимит));

КонецФункции

// Примитивы — как есть; ссылки и перечисления — представлением;
// Неопределено сериализуется в null на стороне движка.
Функция ЗначениеВJSON(ВхЗначение)

	Если ВхЗначение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(ВхЗначение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат ВхЗначение;
	КонецЕсли;

	Возврат Строка(ВхЗначение);

КонецФункции

// feenlace/mcp-1c: выполнение с &параметрами.
Функция ВыполнитьЗапросСПараметрами(Аргументы)

	ТекстЗапроса = СокрЛП(Аргументы.query);
	ПроверитьТолькоВыборка(ТекстЗапроса);
	Лимит = ?(Аргументы.Свойство("limit"), Аргументы.limit, 50);
	ПроверитьЛимит(Лимит, "limit", 200);
	Попытка
		Запрос = Новый Запрос(ТекстЗапроса);
		УстановитьПараметрыЗапроса(Запрос, Аргументы);
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ВызватьИсключение "Ошибка запроса: " + ОписаниеОшибки();
	КонецПопытки;
	Колонки = РезультатЗапроса.Колонки;
	Выборка = РезультатЗапроса.Выбрать();
	Строки = Новый Массив;
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		Счетчик = Счетчик + 1;
		Если Счетчик > Лимит Тогда
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.Имя, ЗначениеВJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	Возврат РезультатВJSON(Новый Структура("rows, truncated", Строки, Счетчик > Лимит));

КонецФункции

Процедура УстановитьПараметрыЗапроса(Запрос, Аргументы)

	Если НЕ Аргументы.Свойство("parameters") ИЛИ Аргументы.parameters = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Параметры = Аргументы.parameters;
	// JSON-структура от mcp_Метаданные приходит как Структура.
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Для Каждого КлючЗначение Из Параметры Цикл
			Запрос.УстановитьПараметр(КлючЗначение.Ключ, КлючЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

// Пробное выполнение с ПЕРВЫЕ 1. Вердикт — строкой (не исключением),
// чтобы агент различал «синтаксис ок» и «ошибка».
Функция ПроверитьЗапрос(Аргументы)

	ТекстЗапроса = СокрЛП(Аргументы.query);
	ПроверитьТолькоВыборка(ТекстЗапроса);

	ТекстПроверки = "ВЫБРАТЬ ПЕРВЫЕ 1 * ИЗ (" + ТекстЗапроса + ") КАК ПроверкаЗапроса";
	ЗапросПроверки = Новый Запрос(ТекстПроверки);
	УстановитьПараметрыЗапроса(ЗапросПроверки, Аргументы);
	Попытка
		ЗапросПроверки.Выполнить();
	Исключение
		Возврат "ОШИБКА: " + ОписаниеОшибки();
	КонецПопытки;

	Возврат "OK: синтаксис корректен.";

КонецФункции

// Сериализует результат в JSON-строку. Движок одиночное значение заворачивает
// в текстовый блок как есть, а структуры/массивы портит через Строка().
Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
