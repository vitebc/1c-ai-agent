Процедура ДобавитьИнструменты(Инструменты) Экспорт

	// get_object_by_link — OneBridge (MIT): объект по навигационной ссылке.
	ПараметрыОбъекта = Новый Массив;
	ПараметрыОбъекта.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"link", "string", "Навигационная ссылка 1С (напр. 'e1cib/data/...')", , Истина));
	СхемаОбъекта = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыОбъекта);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_object_by_link",
		"Объект по навигационной ссылке (OneBridge/MIT): читает объект по link.",
		СхемаОбъекта);

	// get_link_of_object — OneBridge (MIT): навигационная ссылка по ref.
	ПараметрыСсылки = Новый Массив;
	ПараметрыСсылки.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"ref", "string", "Ссылка на объект (Guid/Идентификатор)", , Истина));
	СхемаСсылки = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыСсылки);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_link_of_object",
		"Навигационная ссылка объекта (OneBridge/MIT): возвращает link по ref.",
		СхемаСсылки);

	// find_references_to_object — OneBridge (MIT): поиск всех ссылок на объект.
	ПараметрыПоиска = Новый Массив;
	ПараметрыПоиска.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"ref", "string", "Ссылка на объект для поиска вхождений", , Истина));
	ПараметрыПоиска.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум результатов (целое 1-200)", 50));
	СхемаПоиска = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыПоиска);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"find_references_to_object",
		"Ссылки на объект в базе (OneBridge/MIT): поиск всех вхождений ref, кап 200.",
		СхемаПоиска);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_object_by_link" Тогда
		Возврат ОбъектПоСсылке(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_link_of_object" Тогда
		Возврат СсылкаОбъекта(Аргументы);
	ИначеЕсли ИмяИнструмента = "find_references_to_object" Тогда
		Возврат НайтиСсылкиНаОбъект(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ОбъектПоСсылке(Аргументы)

	СсылкаСтрокой = СокрЛП(Аргументы.link);
	Если НЕ ЗначениеЗаполнено(СсылкаСтрокой) Тогда
		ВызватьИсключение "Параметр link пустой: укажите навигационную ссылку.";
	КонецЕсли;

	Попытка
		СсылкаНаОбъект = ЗначениеИзСтрокиВнутр(СсылкаСтрокой);
	Исключение
		СсылкаНаОбъект = Неопределено;
	КонецПопытки;
	Если СсылкаНаОбъект = Неопределено Тогда
		Возврат РезультатВJSON(Новый Структура("found, hint", Ложь, "Ссылка не распознана: " + СсылкаСтрокой));
	КонецЕсли;

	Попытка
		Мета = СсылкаНаОбъект.Метаданные();
		Данные = Новый Структура;
		Данные.Вставить("type", Мета.Имя);
		Данные.Вставить("ref", Строка(СсылкаНаОбъект.УникальныйИдентификатор()));
		Данные.Вставить("presentation", Строка(СсылкаНаОбъект));
		Реквизиты = Новый Структура;
		ОбъектДанные = СсылкаНаОбъект.ПолучитьОбъект();
		Если ОбъектДанные <> Неопределено Тогда
			Для Каждого Реквизит Из Мета.Реквизиты Цикл
				Попытка
					Реквизиты.Вставить(Реквизит.Имя, ЗначениеВJSON(ОбъектДанные[Реквизит.Имя]));
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		Данные.Вставить("fields", Реквизиты);
		Возврат РезультатВJSON(Новый Структура("found, object", Истина, Данные));
	Исключение
		Возврат РезультатВJSON(Новый Структура("found, hint", Ложь, "Ошибка: " + ОписаниеОшибки()));
	КонецПопытки;

КонецФункции

Функция СсылкаОбъекта(Аргументы)

	Ид = СокрЛП(Аргументы.ref);
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		ВызватьИсключение "Параметр ref пустой: укажите ссылку (навигационную или внутреннюю).";
	КонецЕсли;

	Попытка
		СсылкаНаОбъект = ЗначениеИзСтрокиВнутр(Ид);
	Исключение
		СсылкаНаОбъект = Неопределено;
	КонецПопытки;
	Если СсылкаНаОбъект = Неопределено Тогда
		Возврат РезультатВJSON(Новый Структура("found, hint", Ложь, "Ссылка не распознана: " + Ид));
	КонецЕсли;

	Возврат РезультатВJSON(Новый Структура("link", ЗначениеВСтрокуВнутр(СсылкаНаОбъект)));

КонецФункции

Функция НайтиСсылкиНаОбъект(Аргументы)

	Ид = СокрЛП(Аргументы.ref);
	Если НЕ ЗначениеЗаполнено(Ид) Тогда
		ВызватьИсключение "Параметр ref пустой.";
	КонецЕсли;

	Лимит = 50;
	Если Аргументы.Свойство("limit") Тогда
		Лимит = Аргументы.limit;
	КонецЕсли;

	// Полный поиск ссылок по всем таблицам БД требует прохода вне языка запросов.
	// Заглушка с честной подсказкой: для прод-базы — через COMConnector/внешний компонент.
	Подсказка = "Полный поиск ссылок требует COMConnector/внешний компонент. "
		+ "Для прод-базы настройте COMConnector.";

	Возврат РезультатВJSON(Новый Структура("references, count, hint, ref", Новый Массив, 0, Подсказка, Ид));

КонецФункции

Функция ЗначениеВJSON(ВхЗначение)

	Если ВхЗначение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ТипЗначения = ТипЗнч(ВхЗначение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число")
		ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
		Возврат ВхЗначение;
	КонецЕсли;

	Возврат Строка(ВхЗначение);

КонецФункции

Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти