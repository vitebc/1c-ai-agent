#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = "http://localhost:8000";
	КонецЕсли;

	ЗагрузитьНастройкиФормы();
	ОбновитьОтображениеОтвета();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресБэкендаПриИзменении(Элемент)

	ОбновитьПредставлениеАдресаНаСервере();
	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура ВыполнятьВФонеПриИзменении(Элемент)

	СохранитьНастройкиФормы();

КонецПроцедуры

&НаКлиенте
Процедура РазмерКонтекстаПриИзменении(Элемент)

	Если РазмерКонтекста < 0 Тогда
		РазмерКонтекста = 0;
	КонецЕсли;

	СохранитьНастройкиФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отправить(Команда)

	Если ПустаяСтрока(Промпт) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Введите промпт'"));
		Возврат;
	КонецЕсли;

	Если ЕстьОтмеченныеВложения() Тогда
		// В фазе 1 мультимодальные ограничения не проверяем — заглушка
	КонецЕсли;

	Элементы.Отправить.Доступность = Ложь;

	ТекущийПромпт = Промпт;
	Промпт = "";

	Если ВыполнятьВФоне Тогда
		ЗапуститьЗапросВФоне(ТекущийПромпт);
	Иначе
		ВыполнитьЗапросСинхронно(ТекущийПромпт);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЕстьОтмеченныеВложения()

	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" И СтрокаТаблицы.Отправлять = Истина Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

&НаКлиенте
Процедура Очистить(Команда)

	Промпт = "";
	ИдентификаторСессии = 0; // новый диалог — новая сессия бэкенда
	ОчиститьИсториюНаСервере();
	ТаблицаВложений.Очистить();
	ВложенияТекст = "";

КонецПроцедуры

&НаКлиенте
Процедура ПрикрепитьФайлы(Команда)

	// Фаза 1: диалог выбора файлов. Требует БСП ФайловаяСистемаКлиент — пока заглушка.
	ПоказатьПредупреждение(, НСтр("ru = 'Прикрепление файлов появится в фазе 2'"));

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВложения(Команда)

	ТаблицаВложений.Очистить();
	ВложенияТекст = "";
	ОбновитьВложенияТекстНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ВыполнениеЗапроса

&НаКлиенте
Процедура ВыполнитьЗапросСинхронно(ТекущийПромпт)

	ДобавитьСообщениеВИсториюЛокально("user", ТекущийПромпт);

	РезультатЗапроса = ВыполнитьЗапросНаСервере(ТекущийПромпт);

	Элементы.Отправить.Доступность = Истина;

	ПроцессИтогиЗапроса(РезультатЗапроса);

КонецПроцедуры

&НаСервере
Функция ВыполнитьЗапросНаСервере(Знач ТекстПромпта)

	// Адаптация под наш бэкенд FastAPI /chat (SSE). Формируем JSON и парсим SSE-ответ.
	Попытка
		Ответ = ВызватьБэкендЧат(ТекстПромпта);
	Исключение
		ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Результат = Новый Структура;
		Результат.Вставить("ЭтоОшибка", Истина);
		Результат.Вставить("ТекстОшибки", ТекстОшибки);
		Результат.Вставить("ТекстОтвета", "");
		Результат.Вставить("ВсегоТокенов", 0);
		Результат.Вставить("ВремяОтветаСекунд", 0);
		Результат.Вставить("МодельОтвета", "");
		Результат.Вставить("ВложенияОтвета", Новый Массив);
		Возврат Результат;
	КонецПопытки;

	Возврат Ответ;

КонецФункции

&НаСервере
Функция ВызватьБэкендЧат(Знач ТекстПромпта)

	Адрес = СокрЛП(АдресБэкенда);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;
	Если ПустаяСтрока(Адрес) Тогда
		Адрес = "http://localhost:8000";
	КонецЕсли;

	ПараметрыАдреса = РазобратьАдресБэкенда(Адрес);

	ТелоЗапроса = Новый Структура;
	ТелоЗапроса.Вставить("message", ТекстПромпта);
	ТелоЗапроса.Вставить("user_id", ИмяПользователя());
	ТелоЗапроса.Вставить("base_name", a1c_ЧатФоновый.ИмяИнформационнойБазы());
	// Сессия бэкенда: без неё каждый вопрос — новая сессия без истории.
	Если ИдентификаторСессии > 0 Тогда
		ТелоЗапроса.Вставить("session_id", ИдентификаторСессии);
	КонецЕсли;
	ТелоЗапроса.Вставить("context_size", РазмерКонтекста);

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ТелоЗапроса);
	СтрокаJSON = ЗаписьJSON.Закрыть();

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");

	Запрос = Новый HTTPЗапрос("/chat", Заголовки);
	Запрос.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8);

	Если ПараметрыАдреса.Защищенное Тогда
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Иначе
		Соединение = Новый HTTPСоединение(ПараметрыАдреса.Сервер, ПараметрыАдреса.Порт, , , , 300);
	КонецЕсли;

	ОтветHTTP = Соединение.ОтправитьДляОбработки(Запрос);
	КодОтвета = ОтветHTTP.КодСостояния;
	ТелоОтвета = ОтветHTTP.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Если КодОтвета <> 200 Тогда
		Результат = Новый Структура;
		Результат.Вставить("ЭтоОшибка", Истина);
		Результат.Вставить("ТекстОшибки", СтрШаблон(НСтр("ru = 'Бэкенд вернул HTTP %1: %2'"), КодОтвета, Лев(ТелоОтвета, 500)));
		Результат.Вставить("ТекстОтвета", "");
		Результат.Вставить("ВсегоТокенов", 0);
		Результат.Вставить("ВремяОтветаСекунд", 0);
		Результат.Вставить("МодельОтвета", "");
		Результат.Вставить("ВложенияОтвета", Новый Массив);
		Возврат Результат;
	КонецЕсли;

	ТекстОтвета = ИзвлечьОтветИзSSE(ТелоОтвета);

	Результат = Новый Структура;
	Результат.Вставить("ЭтоОшибка", Ложь);
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("ТекстОтвета", ТекстОтвета);
	Результат.Вставить("ВсегоТокенов", 0);
	Результат.Вставить("ВремяОтветаСекунд", 0);
	Результат.Вставить("МодельОтвета", "");
	Результат.Вставить("ВложенияОтвета", Новый Массив);
	// Сохраняем session_id из done, иначе следующий вопрос уйдёт без контекста.
	Попытка
		Мета = ИзвлечьМетаИзSSE(ТелоОтвета);
		Если Мета <> Неопределено Тогда
			Если Мета.Свойство("session_id") Тогда
				ИдентификаторСессии = Мета.session_id;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция РазобратьАдресБэкенда(Знач Адрес)

	// Поддерживает http://host:port и https://host:port
	Результат = Новый Структура("Сервер, Порт, Защищенное", "localhost", 8000, Ложь);
	Стр = СокрЛП(Адрес);
	Защищенное = Ложь;
	Если СтрНачинаетсяС(НРег(Стр), "https://") Тогда
		Защищенное = Истина;
		Стр = Сред(Стр, 9);
	ИначеЕсли СтрНачинаетсяС(НРег(Стр), "http://") Тогда
		Стр = Сред(Стр, 8);
	КонецЕсли;

	// Отрезать путь
	ПозицияСлэша = СтрНайти(Стр, "/");
	Если ПозицияСлэша > 0 Тогда
		Стр = Лев(Стр, ПозицияСлэша - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(Стр, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Результат.Сервер = Лев(Стр, ПозицияДвоеточия - 1);
		ПортСтрокой = Сред(Стр, ПозицияДвоеточия + 1);
		Попытка
			Результат.Порт = Число(ПортСтрокой);
		Исключение
			Результат.Порт = ?(Защищенное, 443, 80);
		КонецПопытки;
	Иначе
		Результат.Сервер = Стр;
		Результат.Порт = ?(Защищенное, 443, 80);
	КонецЕсли;
	Результат.Защищенное = Защищенное;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьОтветИзSSE(Знач ТелоSSE)

	// Собирает все event: answer -> data.delta
	Результат = "";
	Строки = СтрРазделить(ТелоSSE, Символы.ПС, Ложь);
	Для Каждого Стр Из Строки Цикл
		С = СокрЛП(Стр);
		Если СтрНачинаетсяС(С, "data:") Тогда
			JSONСтр = СокрЛП(Сред(С, 6));
			Если ПустаяСтрока(JSONСтр) Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(JSONСтр);
				Данные = ПрочитатьJSON(Чтение);
				Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("delta") Тогда
					Результат = Результат + Данные.delta;
				КонецЕсли;
			Исключение
				// Пропустить битый фрагмент
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;

	// Fallback: если нет SSE, вернуть как есть (обрезанная)
	Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ТелоSSE) Тогда
		// Попытка интерпретировать как JSON {answer}
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТелоSSE);
			Данные = ПрочитатьJSON(Чтение);
			Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("answer") Тогда
				Возврат Данные.answer;
			КонецЕсли;
		Исключение
		КонецПопытки;
		// Вернуть сырое тело (до 4000)
		Возврат Лев(ТелоSSE, 4000);
	КонецЕсли;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция ИзвлечьМетаИзSSE(Знач ТелоSSE)

	Строки = СтрРазделить(ТелоSSE, Символы.ПС, Ложь);
	Для Каждого Стр Из Строки Цикл
		С = СокрЛП(Стр);
		Если СтрНачинаетсяС(С, "data:") Тогда
			JSONСтр = СокрЛП(Сред(С, 6));
			Попытка
				Чтение = Новый ЧтениеJSON;
				Чтение.УстановитьСтроку(JSONСтр);
				Данные = ПрочитатьJSON(Чтение);
				Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("session_id") Тогда
					Возврат Данные;
				КонецЕсли;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Процедура ЗапуститьЗапросВФоне(ТекстПромпта)

	ДобавитьСообщениеВИсториюЛокально("user", ТекстПромпта);

	Попытка
		ФоновоеЗадание = ЗапуститьЗапросВФонеНаСервере(ТекстПромпта);
	Исключение
		ТекстОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка запуска фонового задания:%1%2'"),
			Символы.ПС,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);

		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецПопытки;

	Если ФоновоеЗадание = Неопределено Тогда
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	// Ожидание без БСП — простой опрос. Для фазы 1 показываем оповещение и ждем синхронно через ОбработчикОжидания.
	// Упрощение: сразу пытаемся получить результат.
	Попытка
		ФоновоеЗадание.ОжидатьЗавершения(300);
	Исключение
	КонецПопытки;

	// СостояниеФоновогоЗадания как перечисление не доступно на клиенте в расширении без БСП — сравниваем строкой
	СостояниеСтрокой = "";
	Попытка
		СостояниеСтрокой = Строка(ФоновоеЗадание.Состояние);
	Исключение
		СостояниеСтрокой = "";
	КонецПопытки;

	Если СостояниеСтрокой = "Активно" Тогда
		ДобавитьСообщениеВИсториюЛокально("error", НСтр("ru = 'Фоновое задание не завершилось за 300с'"));
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	Если СостояниеСтрокой = "ЗавершеноАварийно" Тогда
		ТекстОшибки = "";
		Попытка
			ТекстОшибки = ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);
		Исключение
		КонецПопытки;
		ДобавитьСообщениеВИсториюЛокально("error", ТекстОшибки);
		Элементы.Отправить.Доступность = Истина;
		Возврат;
	КонецЕсли;

	Попытка
		РезультатЗапроса = ПолучитьРезультатИзХранилища(ФоновоеЗадание.АдресРезультата);
	Исключение
		РезультатЗапроса = Неопределено;
	КонецПопытки;

	Элементы.Отправить.Доступность = Истина;

	Если РезультатЗапроса <> Неопределено Тогда
		// Сессия из фонового результата, иначе следующий вопрос — без контекста.
		Если ТипЗнч(РезультатЗапроса) = Тип("Структура")
			И РезультатЗапроса.Свойство("ИдентификаторСессии")
			И РезультатЗапроса.ИдентификаторСессии > 0 Тогда
			ИдентификаторСессии = РезультатЗапроса.ИдентификаторСессии;
		КонецЕсли;
		ПроцессИтогиЗапроса(РезультатЗапроса);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапуститьЗапросВФонеНаСервере(Знач ТекстПромпта)

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ТекстПромпта);
	ПараметрыЗадания.Добавить(АдресБэкенда);
	ПараметрыЗадания.Добавить(ИмяПользователя());
	ПараметрыЗадания.Добавить(ИдентификаторСессии);
	ПараметрыЗадания.Добавить(РазмерКонтекста);

	// Метод фонового задания обязан жить в общем модуле (a1c_ЧатФоновый),
	// вызов из модуля формы платформа отклоняет.
	Задание = ФоновыеЗадания.Выполнить("a1c_ЧатФоновый.ВыполнитьЗапрос", ПараметрыЗадания, Новый УникальныйИдентификатор, НСтр("ru = 'Запрос к бэкенду a1c'"));

	Возврат Задание;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРезультатИзХранилища(Знач АдресРезультата)

	Если ПустаяСтрока(АдресРезультата) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Результат = ПолучитьИзВременногоХранилища(АдресРезультата);
		Возврат Результат;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПроцессИтогиЗапроса(РезультатЗапроса)

	Если РезультатЗапроса = Неопределено Тогда
		ДобавитьСообщениеВИсториюЛокально("error", НСтр("ru = 'Пустой ответ бэкенда'"));
		Возврат;
	КонецЕсли;

	Если РезультатЗапроса.ЭтоОшибка Тогда
		ДобавитьСообщениеВИсториюЛокально("error", РезультатЗапроса.ТекстОшибки);
		Возврат;
	КонецЕсли;

	Метаинформация = СформироватьМетаинформацию(РезультатЗапроса) + ПодписиВложенийОтвета(РезультатЗапроса.ВложенияОтвета);
	ТокенКартинок = ДобавитьВложенияОтветаВТаблицу(РезультатЗапроса.ВложенияОтвета);
	Если Не ПустаяСтрока(ТокенКартинок) Тогда
		Метаинформация = Метаинформация + "[[КИИ_ИЗО:" + ТокенКартинок + "]]";
	КонецЕсли;
	ДобавитьСообщениеВИсториюЛокально("assistant", РезультатЗапроса.ТекстОтвета, Метаинформация);
	Для Каждого СтрокаТаблицы Из ТаблицаВложений Цикл
		Если СтрокаТаблицы.Направление = "Исходящее" Тогда
			СтрокаТаблицы.Отправлять = Ложь;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область РаботаСИсторией

&НаСервере
Процедура ДобавитьСообщениеВИсториюЛокально(Роль, Текст, Метаинформация = "")

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ДобавитьСообщение НАЧАЛО: Роль=" + Роль + ", было=" + ИсторияДиалога.Количество() + ", текст=" + Лев(Текст, 50));
	Исключение
	КонецПопытки;

	НоваяСтрока = ИсторияДиалога.Добавить();
	НоваяСтрока.Роль = Роль;
	НоваяСтрока.Текст = Текст;
	НоваяСтрока.Метаинформация = Метаинформация;

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ДобавитьСообщение ПОСЛЕ ДОБАВЛЕНИЯ: стало=" + ИсторияДиалога.Количество());
	Исключение
	КонецПопытки;

	ОбновитьОтображениеОтвета();

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ДобавитьСообщение ПОСЛЕ ОБНОВЛЕНИЯ HTML: Количество=" + ИсторияДиалога.Количество() + ", ОтветHTML длина=" + СтрДлина(ОтветHTML));
	Исключение
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Функция СформироватьМетаинформацию(РезультатЗапроса)

	МодельОтвета = ?(ПустаяСтрока(РезультатЗапроса.МодельОтвета),
		"N/A",
		РезультатЗапроса.МодельОтвета);

	Метаинформация = СтрШаблон(
		НСтр("ru = '⚡ Токены: %1 | ⏱ Время: %2с | ⚒ Модель: %3'"),
		РезультатЗапроса.ВсегоТокенов,
		Формат(РезультатЗапроса.ВремяОтветаСекунд, "ЧЦ=5; ЧДЦ=1"),
		МодельОтвета);

	Возврат Метаинформация;

КонецФункции

&НаСервере
Процедура ОчиститьИсториюНаСервере()

	ИсторияДиалога.Очистить();
	ОбновитьОтображениеОтвета();

КонецПроцедуры

#КонецОбласти

#Область ОтображениеДиалога

&НаСервере
Процедура ОбновитьОтображениеОтвета()

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ОбновитьОтображениеОтвета НАЧАЛО: Количество=" + ИсторияДиалога.Количество());
	Исключение
	КонецПопытки;

	Если ИсторияДиалога.Количество() = 0 Тогда
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Попытка
			ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ОбновитьОтображениеОтвета ПУСТО: ОтветHTML длина=" + СтрДлина(ОтветHTML));
		Исключение
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Попытка
		Шаблон = Обработки.a1c_Чат.ПолучитьМакет("ШаблонДиалога").ПолучитьТекст();
	Исключение
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Ошибка, , , "ПолучитьМакет ШаблонДиалога упал: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОтветHTML = СформироватьПустуюИсториюHTML();
		Возврат;
	КонецПопытки;

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ШаблонДиалога получен, длина=" + СтрДлина(Шаблон));
	Исключение
	КонецПопытки;

	ИндексыСКартинками = Новый Массив;
	ИндексСообщения = 0;
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		Если СтрНайти(Сообщение.Метаинформация, "[[КИИ_ИЗО:") > 0 Тогда
			ИндексыСКартинками.Добавить(ИндексСообщения);
		КонецЕсли;
		ИндексСообщения = ИндексСообщения + 1;
	КонецЦикла;
	ПорогИнлайна = 0;
	ИнлайнИндексы = Новый Соответствие;
	Для Сч = ПорогИнлайна По ИндексыСКартинками.Количество() - 1 Цикл
		ИнлайнИндексы.Вставить(ИндексыСКартинками[Сч], Истина);
	КонецЦикла;

	СообщенияHTML = "";
	ИндексСообщения = 0;
	Для Каждого Сообщение Из ИсторияДиалога Цикл
		ИнлайнЭто = (ИнлайнИндексы[ИндексСообщения] = Истина);
		СообщенияHTML = СообщенияHTML + СформироватьHTMLСообщения(Сообщение, ИнлайнЭто);
		ИндексСообщения = ИндексСообщения + 1;
	КонецЦикла;

	HTML = СтрЗаменить(Шаблон, "[MESSAGES]", СообщенияHTML);

	ОтветHTML = HTML;

	Попытка
		ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Информация, , , "ОбновитьОтображениеОтвета КОНЕЦ: ОтветHTML длина=" + СтрДлина(ОтветHTML));
	Исключение
	КонецПопытки;

	// fallback на старый шаблон если новый пустой
	Если ПустаяСтрока(ОтветHTML) Тогда
		Попытка
			ЗаписьЖурналаРегистрации("a1c_Чат.Отладка", УровеньЖурналаРегистрации.Ошибка, , , "ОтветHTML пустой после замены!");
		Исключение
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СформироватьПустуюИсториюHTML()

	HTML = "
	|<!DOCTYPE html>
	|<html>
	|<head>
	|    <meta charset='UTF-8'>
	|    <style>
	|        body {
	|            font-family: Arial;
	|            padding: 20px;
	|            text-align: center;
	|            color: #999;
	|        }
	|    </style>
	|</head>
	|<body>
	|    <p>✎ История диалога пуста</p>
	|    <p>Задайте вопрос, чтобы начать общение</p>
	|</body>
	|</html>";

	Возврат HTML;

КонецФункции

&НаСервере
Функция СформироватьHTMLСообщения(Сообщение, ИнлайнитьКартинки = Ложь)

	ОписаниеРоли = ОписаниеРолиСообщения(Сообщение.Роль);
	ТекстСообщения = ОбработатьТекстСообщения(Сообщение.Текст);

	ДанныеКартинок = ИзвлечьТокенКартинок(Сообщение.Метаинформация);
	МетаТекст = ДанныеКартинок.МетаТекст;
	КартинкиHTML = "";
	Если ДанныеКартинок.ЕстьКартинки И ИнлайнитьКартинки Тогда
		КартинкиHTML = HTMLИнлайнКартинок(ДанныеКартинок.СписокАдресов);
	КонецЕсли;

	HTML = СтрШаблон("
			|<div class='message %1'>
			|    <div class='role'>%2 %3</div>
			|    <div class='content'>%4</div>",
			ОписаниеРоли.Класс, ОписаниеРоли.Эмодзи, ОписаниеРоли.ИмяРоли, ТекстСообщения);

	Если Не ПустаяСтрока(КартинкиHTML) Тогда
		HTML = HTML + СтрШаблон("
		|    <div class='content'>%1</div>", КартинкиHTML);
	КонецЕсли;

	Если Не ПустаяСтрока(МетаТекст) Тогда
		МетаHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(МетаТекст);
		HTML = HTML + СтрШаблон("
		|    <div class='meta'>%1</div>", МетаHTML);
	КонецЕсли;

	HTML = HTML + "
			|</div>";

	Возврат HTML;

КонецФункции

// CSS-класс, подпись и эмодзи для роли сообщения диалога.
&НаСервереБезКонтекста
Функция ОписаниеРолиСообщения(Знач Роль)

	Если Роль = "user" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "user", НСтр("ru = 'Пользователь'"), "✎");
	ИначеЕсли Роль = "assistant" Тогда
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "assistant", НСтр("ru = 'ИИ эксперт'"), "⚒");
	Иначе
		// Все прочие роли (включая error) рисуем как ошибку.
		Возврат Новый Структура("Класс, ИмяРоли, Эмодзи", "error", НСтр("ru = 'Ошибка'"), "⚠");
	КонецЕсли;

КонецФункции

// Выделяет из метаинформации токен [[КИИ_ИЗО:...]] со списком индексов сгенерированных
// картинок. Возвращает структуру: МетаТекст (очищенный от токена), СписокАдресов, ЕстьКартинки.
&НаСервереБезКонтекста
Функция ИзвлечьТокенКартинок(Знач МетаТекст)

	Результат = Новый Структура("МетаТекст, СписокАдресов, ЕстьКартинки", МетаТекст, "", Ложь);

	НачТокена = СтрНайти(МетаТекст, "[[КИИ_ИЗО:");
	Если НачТокена = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ОстатокТокена = Сред(МетаТекст, НачТокена);
	КонецТокенаОтн = СтрНайти(ОстатокТокена, "]]");
	Если КонецТокенаОтн = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	ПолныйТокен = Сред(МетаТекст, НачТокена, КонецТокенаОтн + 1);
	Результат.СписокАдресов = СтрЗаменить(СтрЗаменить(ПолныйТокен, "[[КИИ_ИЗО:", ""), "]]", "");
	Результат.МетаТекст = СтрЗаменить(МетаТекст, ПолныйТокен, "");
	Результат.ЕстьКартинки = Истина;

	Возврат Результат;

КонецФункции

// Строки таблицы вложений, сгенерированные моделью (в порядке таблицы).
&НаСервере
Функция СгенерированныеСтрокиВложений()

	СгенерированныеСтроки = Новый Массив;
	Для Каждого СтрокаТбл Из ТаблицаВложений Цикл
		Если СтрокаТбл.Направление = "Сгенерировано" Тогда
			СгенерированныеСтроки.Добавить(СтрокаТбл);
		КонецЕсли;
	КонецЦикла;

	Возврат СгенерированныеСтроки;

КонецФункции

// Собирает inline-HTML картинок по списку индексов из токена (битые индексы пропускаются).
&НаСервере
Функция HTMLИнлайнКартинок(Знач СписокАдресов)

	КартинкиHTML = "";
	СгенерированныеСтроки = СгенерированныеСтрокиВложений();

	Для Каждого ИндексСтрокой Из СтрРазделить(СписокАдресов, ",", Ложь) Цикл
		Индекс = Число(СокрЛП(ИндексСтрокой));
		Если Индекс = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Индекс < 0 Или Индекс > СгенерированныеСтроки.Количество() - 1 Тогда
			Продолжить;
		КонецЕсли;
		КартинкиHTML = КартинкиHTML + HTMLКартинкиВложения(СгенерированныеСтроки[Индекс]);
	КонецЦикла;

	Возврат КартинкиHTML;

КонецФункции

// data-URL img-тег одной сгенерированной картинки; пусто, если вложение не двоичные данные.
&НаСервере
Функция HTMLКартинкиВложения(Знач СтрокаКартинки)

	Попытка
		ДвоичныеКартинки = ПолучитьИзВременногоХранилища(СтрокаКартинки.Адрес);
	Исключение
		Возврат "";
	КонецПопытки;

	Если ТипЗнч(ДвоичныеКартинки) <> Тип("ДвоичныеДанные") Тогда
		Возврат "";
	КонецЕсли;

	МимеКартинки = ?(ПустаяСтрока(СтрокаКартинки.MIME), "image/png", СтрокаКартинки.MIME);
	Base64Картинки = Base64Строка(ДвоичныеКартинки);
	Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ПС, "");
	Base64Картинки = СтрЗаменить(Base64Картинки, Символы.ВК, "");
	МимеБезопасный = a1c_МаркдаунПарсер.ЭкранироватьHTML(МимеКартинки);

	Возврат "<div style=""margin-top:6px"">"
		+ "<img src=""data:" + МимеБезопасный + ";base64," + Base64Картинки + """"
		+ " style=""max-width:480px"">"
		+ "</div>";

КонецФункции

&НаСервере
Функция ОбработатьТекстСообщения(Текст)

	ТипКонтента = ОпределитьТипКонтента(Текст);

	Если ТипКонтента = "HTML" Тогда
		Возврат СтрШаблон("<pre><code class='language-html'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "JSON" Тогда
		Возврат СтрШаблон("<pre><code class='language-json'>%1</code></pre>",
			a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст));

	ИначеЕсли ТипКонтента = "Markdown" Тогда
		Возврат a1c_МаркдаунПарсер.ПреобразоватьВHTML(Текст);
	Иначе
		ТекстHTML = a1c_МаркдаунПарсер.ЭкранироватьHTML(Текст);
		ТекстHTML = СтрЗаменить(ТекстHTML, Символы.ПС, "<br>");
		Возврат ТекстHTML;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ОпределитьТипКонтента(Знач Текст)

	ТекстОбрезанный = СокрЛП(Текст);

	Если ЭтоПолныйHTMLДокумент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Если ЭтоJSON(ТекстОбрезанный) Тогда
		Возврат "JSON";
	КонецЕсли;

	Если ЭтоMarkdown(Текст) Тогда
		Возврат "Markdown";
	КонецЕсли;

	Если ЭтоHTMLФрагмент(ТекстОбрезанный) Тогда
		Возврат "HTML";
	КонецЕсли;

	Возврат "PlainText";

КонецФункции

&НаСервере
Функция ЭтоПолныйHTMLДокумент(Текст)

	ТекстНижний = НРег(Текст);

	Если СтрНачинаетсяС(ТекстНижний, "<!doctype html") Тогда
		Возврат Истина;
	КонецЕсли;

	Если СтрНачинаетсяС(ТекстНижний, "<html")
		И СтрНайти(ТекстНижний, "</html>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Ложь;

КонецФункции

&НаСервере
Функция ЭтоJSON(Знач Текст)
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;

	ПервыйСимвол = Лев(Текст, 1);
	ПоследнийСимвол = Прав(Текст, 1);

	ЭтоОбъект = (ПервыйСимвол = "{" И ПоследнийСимвол = "}");
	ЭтоМассив = (ПервыйСимвол = "[" И ПоследнийСимвол = "]");

	Если НЕ (ЭтоОбъект Или ЭтоМассив) Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Текст);
		ПрочитатьJSON(ЧтениеJSON);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаСервере
Функция ЭтоHTMLФрагмент(Текст)

	ТекстНижний = НРег(Текст);

	НачинаетсяСТега = СтрНачинаетсяС(ТекстНижний, "<div")
		Или СтрНачинаетсяС(ТекстНижний, "<table")
		Или СтрНачинаетсяС(ТекстНижний, "<section")
		Или СтрНачинаетсяС(ТекстНижний, "<article");

	ЗаканчиваетсяТегом = СтрЗаканчиваетсяНа(ТекстНижний, "</div>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</table>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</section>")
		Или СтрЗаканчиваетсяНа(ТекстНижний, "</article>");

	Возврат НачинаетсяСТега И ЗаканчиваетсяТегом;

КонецФункции

&НаСервере
Функция ЭтоMarkdown(Знач Текст)

	Возврат a1c_МаркдаунПарсер.ЭтоMarkdown(Текст);

КонецФункции

#КонецОбласти

#Область НастройкиФормы

&НаСервере
Функция ПолучитьКлючНастроек()

	Возврат "a1c_Чат_НастройкиФормы";

КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкиФормы()

	КлючОбъекта = ПолучитьКлючНастроек();

	Попытка
		Настройки = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, "НастройкиФормы");
	Исключение
		Настройки = Неопределено;
	КонецПопытки;

	Если ТипЗнч(Настройки) <> Тип("Структура") Тогда
		РазмерКонтекста = 5;
		ВыполнятьВФоне = Ложь;
		Возврат;
	КонецЕсли;

	Если Настройки.Свойство("ВыполнятьВФоне") Тогда
		ВыполнятьВФоне = Настройки.ВыполнятьВФоне;
	КонецЕсли;

	Если Настройки.Свойство("РазмерКонтекста") Тогда
		РазмерКонтекста = Настройки.РазмерКонтекста;
	Иначе
		РазмерКонтекста = 5;
	КонецЕсли;

	Если Настройки.Свойство("АдресБэкенда") И ЗначениеЗаполнено(Настройки.АдресБэкенда) Тогда
		АдресБэкенда = Настройки.АдресБэкенда;
	КонецЕсли;

КонецПроцедуры

