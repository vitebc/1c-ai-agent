#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(АдресБэкенда) Тогда
		АдресБэкенда = "http://localhost:8000";
	КонецЕсли;
	ОбновитьЧат();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура АдресБэкендаПриИзменении(Элемент)

	ОбновитьЧатНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЧатНаСервере()

	ОбновитьЧат();

КонецПроцедуры

&НаСервере
Процедура ОбновитьЧат()

	Адрес = СокрЛП(АдресБэкенда);
	Пока Прав(Адрес, 1) = "/" Цикл
		Адрес = Лев(Адрес, СтрДлина(Адрес) - 1);
	КонецЦикла;

	ТекстМакета = Обработки.a1c_Чат.ПолучитьМакет("HTMLЧат").ПолучитьТекст();
	ТекстМакета = СтрЗаменить(ТекстМакета, "%BASE_URL%", Адрес);
	ТекстМакета = СтрЗаменить(ТекстМакета, "%USER_NAME%", ЭкранироватьJSON(ИмяПользователя()));
	СодержимоеHTML = ТекстМакета;

КонецПроцедуры

// Экранирует кавычки и обратные слэши для вставки в JSON-конфиг страницы.
&НаСервереБезКонтекста
Функция ЭкранироватьJSON(Строка)

	Результат = СтрЗаменить(Строка, "\", "\\");
	Результат = СтрЗаменить(Результат, """", "\""");
	Возврат Результат;

КонецФункции

#КонецОбласти
