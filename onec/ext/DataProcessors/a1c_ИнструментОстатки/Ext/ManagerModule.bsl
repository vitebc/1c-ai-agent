Процедура ДобавитьИнструменты(Инструменты) Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"sku", "string", "Подстрока названия номенклатуры для поиска остатков", , Истина));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"warehouse", "string", "Точное наименование склада. Если не указан — все склады."));
	Параметры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"limit", "number", "Максимум строк в ответе (целое 1-100)", 20));
	Схема = mcp_Метаданные.СхемаПараметровИнструмента(Параметры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_stock_balance",
		"Остатки номенклатуры по складам (регистр накопления ТоварыНаСкладах, КА2). Только чтение.",
		Схема);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_stock_balance" Тогда
		Возврат ОстаткиТоваров(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ОстаткиТоваров(Аргументы)

	Номенклатура = СокрЛП(Аргументы.sku);
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		ВызватьИсключение "Параметр sku пустой: укажите подстроку названия номенклатуры.";
	КонецЕсли;

	Лимит = ?(Аргументы.Свойство("limit"), Аргументы.limit, 20);
	ПроверитьЛимит(Лимит, "limit");

	Склад = "";
	Если Аргументы.Свойство("warehouse") Тогда
		Склад = СокрЛП(Аргументы.warehouse);
	КонецЕсли;

	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + "
		|	Остатки.Номенклатура.Наименование КАК Номенклатура,
		|	Остатки.Склад.Наименование КАК Склад,
		|	Остатки.ВНаличииОстаток КАК Количество
		|ИЗ
		|	РегистрНакопления.ТоварыНаСкладах.Остатки(, Номенклатура.Наименование ПОДОБНО &Шаблон) КАК Остатки";
	Если ЗначениеЗаполнено(Склад) Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|ГДЕ
			|	Остатки.Склад.Наименование = &Склад";
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Шаблон", "%" + ЭкранироватьШаблонПодобия(Номенклатура) + "%");
	Если ЗначениеЗаполнено(Склад) Тогда
		Запрос.УстановитьПараметр("Склад", Склад);
	КонецЕсли;

	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();

	// Пустой результат — НЕ ошибка: агент сам сообщит «не найдено».
	Строки = Новый Массив;
	Для Каждого СтрокаТЗ Из ВыборкаТЗ Цикл
		Строки.Добавить(Новый Структура("sku, warehouse, qty",
			СтрокаТЗ.Номенклатура, СтрокаТЗ.Склад, СтрокаТЗ.Количество));
	КонецЦикла;

	Возврат Строки;

КонецФункции

Процедура ПроверитьЛимит(Лимит, ИмяПараметра)

	Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <> Цел(Лимит) ИЛИ Лимит < 1 ИЛИ Лимит > 100 Тогда
		ВызватьИсключение "Параметр " + ИмяПараметра + " должен быть целым числом 1-100.";
	КонецЕсли;

КонецПроцедуры

// Экранирует спецсимволы ПОДОБНО, чтобы ввод искал буквально, а не как маску.
Функция ЭкранироватьШаблонПодобия(Строка)

	Результат = СтрЗаменить(Строка, "%", "[%]");
	Результат = СтрЗаменить(Результат, "_", "[_]");
	Возврат Результат;

КонецФункции

#КонецОбласти
