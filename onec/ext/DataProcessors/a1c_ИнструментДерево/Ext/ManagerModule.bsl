Процедура ДобавитьИнструменты(Инструменты) Экспорт

	// get_metadata_tree — адаптация feenlace/mcp-1c (MIT): дерево метаданных.
	ПараметрыДерева = Новый Массив;
	ПараметрыДерева.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"subsystem", "string", "Фильтр по имени подсистемы (подстрока)"));
	ПараметрыДерева.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"typeFilter", "string", "Фильтр по типу: Catalogs, Documents, AccumulationRegisters..."));
	СхемаДерева = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыДерева);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_metadata_tree",
		"Дерево метаданных 1С (заимствовано из feenlace/mcp-1c, MIT): типы, объекты, синонимы, подсистемы. Только чтение.",
		СхемаДерева);

	// get_object_structure — синоним get_metadata_structure в стиле feenlace.
	ПараметрыСтруктуры = Новый Массив;
	ПараметрыСтруктуры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"name", "string", "Имя объекта, напр. Справочник.Контрагенты или Catalog.Counterparties", , Истина));
	ПараметрыСтруктуры.Добавить(mcp_Метаданные.ПараметрИнструмента(
		"objectType", "string", "Тип для уточнения: Catalog, Document, Subsystem..."));
	СхемаСтруктуры = mcp_Метаданные.СхемаПараметровИнструмента(ПараметрыСтруктуры);
	mcp_Метаданные.ДобавитьИнструмент(
		Инструменты,
		"get_object_structure",
		"Структура одного объекта 1С (заимствовано из feenlace/mcp-1c, MIT): реквизиты, ТЧ, измерения/ресурсы. Только чтение.",
		СхемаСтруктуры);

КонецПроцедуры

Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы) Экспорт

	Если ИмяИнструмента = "get_metadata_tree" Тогда
		Возврат ДеревоМетаданных(Аргументы);
	ИначеЕсли ИмяИнструмента = "get_object_structure" Тогда
		Возврат СтруктураОбъекта(Аргументы);
	КонецЕсли;

	ВызватьИсключение "Неизвестный инструмент: " + ИмяИнструмента;

КонецФункции

#Область СлужебныеПроцедурыИФункции

Функция ДеревоМетаданных(Аргументы)

	ФильтрПодсистемы = "";
	Если Аргументы.Свойство("subsystem") Тогда
		ФильтрПодсистемы = СокрЛП(Аргументы.subsystem);
	КонецЕсли;
	ФильтрТипа = "";
	Если Аргументы.Свойство("typeFilter") Тогда
		ФильтрТипа = СокрЛП(Аргументы.typeFilter);
	КонецЕсли;

	Дерево = Новый Массив;

	// Собираем по коллекциям метаданных (без внешних зависимостей, как и list_metadata_objects).
	Коллекции = Новый Массив;
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "Catalogs", Метаданные.Справочники));
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "Documents", Метаданные.Документы));
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "AccumulationRegisters", Метаданные.РегистрыНакопления));
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "InformationRegisters", Метаданные.РегистрыСведений));
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "ChartsOfAccounts", Метаданные.ПланыСчетов));
	Коллекции.Добавить(Новый Структура("Тип, Коллекция", "Catalogs", Метаданные.Справочники)); // дубль намеренно пропускается по имени

	УжеДобавлено = Новый Соответствие;
	Для Каждого ЭлементКоллекции Из Коллекции Цикл
		ТипСтрокой = ЭлементКоллекции.Тип;
		Если ЗначениеЗаполнено(ФильтрТипа) И НРег(ТипСтрокой) <> НРег(ФильтрТипа) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ОбъектМетаданных Из ЭлементКоллекции.Коллекция Цикл
			ИмяОбъекта = ОбъектМетаданных.Имя;
			Ключ = ТипСтрокой + "." + ИмяОбъекта;
			Если УжеДобавлено[Ключ] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			УжеДобавлено.Вставить(Ключ, Истина);
			Синоним = ОбъектМетаданных.Синоним;
			// Простой фильтр по подсистеме — по имени (полного графа подсистем без БСП нет).
			Если ЗначениеЗаполнено(ФильтрПодсистемы) И СтрНайти(НРег(ИмяОбъекта), НРег(ФильтрПодсистемы)) = 0
				И СтрНайти(НРег(Синоним), НРег(ФильтрПодсистемы)) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Дерево.Добавить(Новый Структура("type, name, synonym", ТипСтрокой, ИмяОбъекта, Синоним));
			Если Дерево.Количество() >= 200 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Дерево.Количество() >= 200 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Возврат РезультатВJSON(Новый Структура("tree", Дерево));

КонецФункции

Функция СтруктураОбъекта(Аргументы)

	ИмяЗапроса = СокрЛП(Аргументы.name);
	Если НЕ ЗначениеЗаполнено(ИмяЗапроса) Тогда
		ВызватьИсключение "Параметр name пустой: укажите имя объекта, напр. Справочник.Контрагенты.";
	КонецЕсли;

	// Делегируем существующему инструменту ядра get_metadata_structure:
	// имя может быть Справочник.Контрагенты или Catalog.Counterparties — пробуем как есть.
	Параметры = Новый Структура;
	Параметры.Вставить("name", ИмяЗапроса);
	Если Аргументы.Свойство("objectType") И ЗначениеЗаполнено(Аргументы.objectType) Тогда
		// feenlace: objectType уточняет тип; у ядра — metaType, мапим напрямую.
		Параметры.Вставить("metaType", Аргументы.objectType);
	КонецЕсли;

	// Ядро 1c_mcp реализует get_metadata_structure как отдельный инструмент;
	// вызывать его напрямую нельзя, поэтому дублируем логику упрощённо: ищем объект по имени.
	Попытка
		Части = СтрРазделить(ИмяЗапроса, ".", Ложь);
		ИмяОбъекта = Части[Части.ВГраница()];
		// Перебираем коллекции, ищем по имени.
		Для Каждого Коллекция Из Новый Массив(Метаданные.Справочники, Метаданные.Документы, Метаданные.РегистрыНакопления, Метаданные.РегистрыСведений) Цикл
			Для Каждого ОбъектМетаданных Из Коллекция Цикл
				Если НРег(ОбъектМетаданных.Имя) = НРег(ИмяОбъекта) Тогда
					Реквизиты = Новый Массив;
					Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
						Реквизиты.Добавить(Реквизит.Имя);
					КонецЦикла;
					Возврат РезультатВJSON(Новый Структура("name, synonym, fields", ОбъектМетаданных.Имя, ОбъектМетаданных.Синоним, Реквизиты));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат РезультатВJSON(Новый Структура("name, error", ИмяЗапроса, "Объект не найден: " + ИмяЗапроса));

КонецФункции

Функция РезультатВJSON(ЗначениеРезультата)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ЗначениеРезультата);
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
