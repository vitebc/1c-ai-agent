# Шаблон .env. Активное окружение: cp .env.dev .env (dev) или заполнить вручную (prod).
# Dev и prod — отдельные worktree'ы (см. AGENTS.md, секция «Dev/Prod»).

# --- LLM: локальная (GPU-сервер, llama.cpp-server) ---
LLM_BASE_URL=http://192.168.170.105:12600/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-27b-1C

# --- Агентская петля ---
AGENT_MAX_ROUNDS=15
AGENT_MAX_CONSECUTIVE_ERRORS=3

# --- Postgres (сервис postgres в docker-compose.yml) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentdb
# Dev: 5433, Prod: 5432.
POSTGRES_PORT=5432
# Имя named volume (dev: dev-postgres-data, prod: postgres-data).
POSTGRES_DATA_DIR=postgres-data
# Для локального запуска вне compose (uv run uvicorn):
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agentdb

# --- Порты и образ ---
# Dev: 8001, Prod: 8000.
BACKEND_PORT=8000
BACKEND_IMAGE=1c-ai-agent-backend

# --- Эмбеддинги ---
# Dev: fake (без CPU-сервиса). Prod: tei (профиль rag в compose).
EMBEDDINGS_PROVIDER=fake
TEI_MODEL_ID=deepvk/USER-bge-m3
TEI_PORT=8081

# --- MCP-прокси к 1С (профиль proxy, по умолчанию НЕ поднимается) ---
MCP_ONEC_URL=http://192.168.1.10/base
MCP_AUTH_MODE=none
MCP_ONEC_USERNAME=
MCP_ONEC_PASSWORD=
MCP_PROXY_PORT=8001
MCP_PROXY_IMAGE=1c-ai-agent-mcp-proxy:local

# --- Режим инструментов 1С ---
ONEC_MODE=live
ONEC_TOKEN=
ONEC_MCP_URL=http://localhost:8001
ONEC_MCP_URL_COMPOSE=http://mcp-proxy:8000

# --- Прямые вызовы 1С по базам (без прокси) ---
# Сервисный пользователь (fallback когда JWT_SECRET пуст).
ONEC_USERNAME=agent
ONEC_PASSWORD=

# --- Per-user RLS: JWT (нативная аутентификация 1С) ---
# Ключ HS256 (Base64) — тот же, что в BSL a1c_ЧатФоновый.КлючПодписиТокена()
# и в default.vrd (keyInformation). Пусто — Basic auth под ONEC_USERNAME.
# Dev: пусто. Prod: задан.
JWT_SECRET=

# --- Мапа баз ---
ONEC_BASES=doc3_test=http://192.168.0.69:81/doc3_test;ai_base=http://192.168.60.9/ai_base;ca2_otchet_zhvv=http://192.168.0.49/ca2_otchet
ONEC_BASES_FILE=

# --- Агрегирующий MCP ---
AGG_MCP_URL=http://192.168.60.39:9224/api/mcp-aggregated/mcp
AGG_MCP_TOKEN=
AGG_MCP_CACHE_TTL=300
