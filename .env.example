# Копия в .env (не коммитить!). Все значения — dev-default'ы для VPS.

# --- LLM: любой OpenAI-совместимый эндпоинт ---
# В dev на VPS без GPU сюда подставляется облачная модель.
# ВАЖНО: только синтетические/нечувствительные данные. Прод — локальный
# llama.cpp-server с qwen3.8-27b-1C (см. AGENTS.md, раздел «Жёсткие ограничения»).
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me

# --- Postgres (сервис postgres в docker-compose.yml) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentdb
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agentdb

# --- TEI (профиль rag) ---
TEI_MODEL_ID=deepvk/USER-bge-m3
TEI_PORT=8081

# --- MCP-прокси к 1С (профиль onec) ---
# URL тестовой базы 1С на Windows-VM пользователя (опубликованный HTTP-сервис).
MCP_ONEC_URL=http://192.168.1.10/base
# Режим прокси: none (один фиксированный пользователь, для старта) или oauth2 (per-user).
MCP_AUTH_MODE=none
MCP_ONEC_USERNAME=
MCP_ONEC_PASSWORD=
MCP_PROXY_PORT=8000
# Образ прокси соберём из форка 1c_mcp на шаге 3; пока заглушка.
MCP_PROXY_IMAGE=ghcr.io/placeholder/1c-mcp-proxy:latest
ONEC_MCP_URL=http://localhost:8000
