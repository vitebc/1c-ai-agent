# Копия в .env (не коммитить!). Все значения — dev-default'ы для VPS.

# --- LLM: любой OpenAI-совместимый эндпоинт ---
# В dev на VPS без GPU сюда подставляется облачная модель.
# ВАЖНО: только синтетические/нечувствительные данные. Прод — локальный
# llama.cpp-server с qwen3.8-27b-1C (см. AGENTS.md, раздел «Жёсткие ограничения»).
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me

# --- Postgres (сервис postgres в docker-compose.yml) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent
POSTGRES_DB=agentdb
POSTGRES_PORT=5432
# Для локального запуска вне compose (uv run uvicorn):
DATABASE_URL=postgresql+asyncpg://agent:agent@localhost:5432/agentdb
# В compose backend переопределяет DATABASE_URL на postgres:5432 автоматически.
BACKEND_PORT=8000

# --- TEI (профиль rag) ---
TEI_MODEL_ID=deepvk/USER-bge-m3
TEI_PORT=8081

# --- MCP-прокси к 1С (профиль onec) ---
# URL тестовой базы 1С на Windows-VM пользователя (опубликованный HTTP-сервис).
MCP_ONEC_URL=http://192.168.1.10/base
# Режим прокси: none (один фиксированный пользователь, для старта) или oauth2 (per-user).
MCP_AUTH_MODE=none
MCP_ONEC_USERNAME=
MCP_ONEC_PASSWORD=
MCP_PROXY_PORT=8001
# Тег собранного локально образа прокси (build: ./onec/1c_mcp). Можно переопределить на готовый образ из registry.
MCP_PROXY_IMAGE=1c-ai-agent-mcp-proxy:local
# --- Режим инструментов 1С: mock (тестовые данные) или live (прокси) ---
ONEC_MODE=mock
# Токен только при MCP_AUTH_MODE=oauth2 у прокси; при none не нужен.
ONEC_TOKEN=
# Локальный запуск вне compose: прокси на localhost:8001; внутри compose backend видит прокси как mcp-proxy:8000 (см. ONEC_MCP_URL_COMPOSE).
ONEC_MCP_URL=http://localhost:8001
ONEC_MCP_URL_COMPOSE=http://mcp-proxy:8000
# --- Агрегирующий MCP (подсерверы server__tool: search-ka-update, rlm, ...) ---
# Пусто — отключён. Агент выбирает подсерверы полем mcp в AGENT.md.
AGG_MCP_URL=http://192.168.60.39:9224/api/mcp-aggregated/mcp
AGG_MCP_TOKEN=
# TTL кэша tools/list агрегатора, сек.
AGG_MCP_CACHE_TTL=300
