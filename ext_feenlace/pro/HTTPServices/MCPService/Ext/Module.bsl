// GET /subsystems
// Возвращает { "subsystems": [<дерево подсистем>], "allObjects": [<полные имена>] }.
// subsystems  — дерево корневых подсистем (тот же ОписаниеПодсистемы, что и в /object).
// allObjects  — полные имена ВСЕХ видов верхнего уровня, пригодных для состава
//               подсистемы: прикладные (15) и служебные и прочие (27: Роли,
//               ОбщиеМодули, Константы, РегламентныеЗадания, WebСервисы и прочие).
//               Не входят только Подсистемы (контейнер) и Язык (локализация).
Функция ПодсистемыGET(Запрос)
    Результат = Новый Структура;

    // Единый накопитель нефатальных предупреждений: усечения дерева подсистем
    // (ОписаниеПодсистемы) и пропуски прикладных коллекций универсума сливаются в
    // один массив warnings, чтобы неполнота ответа была видна потребителю (BUG-3b).
    Предупреждения = Новый Массив;

    // Дерево корневых подсистем.
    Подсистемы = Новый Массив;
    Попытка
        Для Каждого КорневаяПодсистема Из Метаданные.Подсистемы Цикл
            Подсистемы.Добавить(ОписаниеПодсистемы(КорневаяПодсистема, Предупреждения));
        КонецЦикла;
    Исключение
        Предупреждения.Добавить("Подсистемы: " + ОписаниеОшибки());
    КонецПопытки;
    Результат.Вставить("subsystems", Подсистемы);

    // Универсум применимых объектов для orphans. Полный набор видов верхнего уровня,
    // пригодных для состава подсистемы: прикладные (15) и служебные и прочие (27:
    // Константы, ОбщиеМодули, Роли, ОпределяемыеТипы, ПодпискиНаСобытия, Стили,
    // ЭлементыСтиля, КритерииОтбора, Последовательности, ОбщиеРеквизиты,
    // НумераторыДокументов, ВнешниеИсточникиДанных и др.), чтобы orphans был согласован
    // с containing. Исключены только Подсистемы (контейнер, а не объект состава) и Язык
    // (документально не входит в состав подсистемы; локализация). Набор видов совпадает
    // по составу с таблицей universeServiceKinds (dump/subsystem_universe_kinds.go),
    // чтобы живой путь и путь по дампу не расходились.
    //
    // Имена коллекций подтверждены по внутреннему корпусу синтакс-помощника
    // (internal/syntaxdata/source/types.json, свойства ОбъектМетаданныхКонфигурация)
    // и живой проверкой на 8.3.27. Всё под Попытка: неверное имя коллекции ловится
    // ниже и фиксируется в предупреждениях (не молчаливый пропуск), худший случай:
    // часть коллекций пропущена с предупреждением, а не 500. Заметки по написанию:
    // регламентные задания лежат в коллекции РегламентныеЗадания, .ПолноеИмя() даёт
    // РегламентноеЗадание; веб сервисы в коллекции WebСервисы (латинское Web);
    // нумераторы документов .ПолноеИмя() даёт НумераторДокументов, коллекция
    // Метаданные.НумераторыДокументов.
    ПрикладныеКоллекции = Новый Массив;
    // Прикладные виды (15).
    ПрикладныеКоллекции.Добавить("Справочники");
    ПрикладныеКоллекции.Добавить("Документы");
    ПрикладныеКоллекции.Добавить("Перечисления");
    ПрикладныеКоллекции.Добавить("Отчеты");
    ПрикладныеКоллекции.Добавить("Обработки");
    ПрикладныеКоллекции.Добавить("РегистрыСведений");
    ПрикладныеКоллекции.Добавить("РегистрыНакопления");
    ПрикладныеКоллекции.Добавить("РегистрыБухгалтерии");
    ПрикладныеКоллекции.Добавить("РегистрыРасчета");
    ПрикладныеКоллекции.Добавить("ПланыСчетов");
    ПрикладныеКоллекции.Добавить("ПланыВидовХарактеристик");
    ПрикладныеКоллекции.Добавить("ПланыВидовРасчета");
    ПрикладныеКоллекции.Добавить("ПланыОбмена");
    ПрикладныеКоллекции.Добавить("БизнесПроцессы");
    ПрикладныеКоллекции.Добавить("Задачи");
    // Служебные и прочие виды верхнего уровня, пригодные для состава подсистемы (27).
    ПрикладныеКоллекции.Добавить("Константы");
    ПрикладныеКоллекции.Добавить("ОбщиеМодули");
    ПрикладныеКоллекции.Добавить("ОбщиеФормы");
    ПрикладныеКоллекции.Добавить("ОбщиеКоманды");
    ПрикладныеКоллекции.Добавить("ГруппыКоманд");
    ПрикладныеКоллекции.Добавить("ОбщиеМакеты");
    ПрикладныеКоллекции.Добавить("ОбщиеКартинки");
    ПрикладныеКоллекции.Добавить("ОпределяемыеТипы");
    ПрикладныеКоллекции.Добавить("HTTPСервисы");
    ПрикладныеКоллекции.Добавить("WebСервисы");
    ПрикладныеКоллекции.Добавить("ПакетыXDTO");
    ПрикладныеКоллекции.Добавить("ПараметрыСеанса");
    ПрикладныеКоллекции.Добавить("РегламентныеЗадания");
    ПрикладныеКоллекции.Добавить("Роли");
    ПрикладныеКоллекции.Добавить("ФункциональныеОпции");
    ПрикладныеКоллекции.Добавить("ПодпискиНаСобытия");
    ПрикладныеКоллекции.Добавить("ЖурналыДокументов");
    ПрикладныеКоллекции.Добавить("ХранилищаНастроек");
    // Финализация до полного набора видов, пригодных для состава подсистемы (каждый
    // встречается в реальном составе вендорских конфигураций). Имена коллекций не
    // подтверждены исходниками репозитория, всё под Попытка (см. заметку выше): неверное
    // имя ловится и фиксируется в предупреждениях, а не роняет ответ.
    ПрикладныеКоллекции.Добавить("Стили");
    ПрикладныеКоллекции.Добавить("ЭлементыСтиля");
    ПрикладныеКоллекции.Добавить("КритерииОтбора");
    ПрикладныеКоллекции.Добавить("Последовательности");
    ПрикладныеКоллекции.Добавить("ОбщиеРеквизиты");
    ПрикладныеКоллекции.Добавить("НумераторыДокументов");
    ПрикладныеКоллекции.Добавить("WSСсылки");
    ПрикладныеКоллекции.Добавить("ПараметрыФункциональныхОпций");
    ПрикладныеКоллекции.Добавить("ВнешниеИсточникиДанных");

    ВсеОбъекты = Новый Массив;
    Для Каждого ИмяКоллекции Из ПрикладныеКоллекции Цикл
        Попытка
            Коллекция = Метаданные[ИмяКоллекции];
            Для Каждого ОбъектМетаданных Из Коллекция Цикл
                Попытка
                    ВсеОбъекты.Добавить(ОбъектМетаданных.ПолноеИмя());
                Исключение
                КонецПопытки;
            КонецЦикла;
        Исключение
            // NEEDS REAL-1C VALIDATION: применимая коллекция, бросившая при обходе,
            // пропускается, но фиксируется в предупреждениях, чтобы деградировавший
            // (неполный) универсум был виден потребителю, а не молча считался полным.
            Предупреждения.Добавить(ИмяКоллекции + ": " + ОписаниеОшибки());
            Продолжить;
        КонецПопытки;
    КонецЦикла;
    Результат.Вставить("allObjects", ВсеОбъекты);
    Если Предупреждения.Количество() > 0 Тогда
        Результат.Вставить("warnings", Предупреждения);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /object/{type}/{name}
//
// Dual-leg dispatch (v0.6.1): см. описание у МодульGET. B leg для основной
// конфигурации, C leg по ?extension= читает структуру через wrapper API.
Функция ОбъектGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];
    ИмяРасш    = "";
    // ПараметрыЗапроса в 1С 8.5 — ни Структура (.Свойство падает), ни обычное
    // Соответствие ([отсутствующий-ключ] падает с «Поле объекта не обнаружено»).
    // Универсально оборачиваем в Попытка (live-1С тест 2026-05-22).
    Попытка
        Значение = Запрос.ПараметрыЗапроса["extension"];
        Если Значение <> Неопределено Тогда
            ИмяРасш = Значение;
        КонецЕсли;
    Исключение
        ИмяРасш = "";
    КонецПопытки;

    Если ПустаяСтрока(ИмяРасш) Тогда
        // ── B leg start ──
        ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
        Если ОбъектМД = Неопределено Тогда
            ИмяРасшНайдено = ОбъектПринадлежитРасширению(ТипОбъекта, ИмяОбъекта);
            Если НЕ ПустаяСтрока(ИмяРасшНайдено) Тогда
                Возврат Ответ501СExtensionOwner(ИмяРасшНайдено);
            КонецЕсли;
            Возврат ОтветОшибка(404, "Object not found");
        КонецЕсли;
        // Маркер неоднозначности (короткое имя Subsystem дало >1 совпадение): вернуть
        // JSON со списком полных имён {"ambiguous": [...]}, чтобы Go-сторона показала
        // сигнал уточнения вместо пустой структуры. Объект метаданных не является
        // Структурой, поэтому проверка типа надёжно отличает маркер.
        Если ТипОбъекта = "Subsystem" И ТипЗнч(ОбъектМД) = Тип("Структура") Тогда
            Возврат ОтветJSON(ОбъектМД);
        КонецЕсли;

        Результат = СобратьСтруктуруОбъекта(ОбъектМД);

        // Состав определяемого типа. Guard по ТипОбъекта, а не по наличию свойства .Тип
        // (защита от ложного срабатывания на других объектах, у которых тоже есть .Тип).
        Если ТипОбъекта = "DefinedType" Тогда
            СоставТипов = Новый Массив;
            Попытка
                // NEEDS REAL-1C VALIDATION: доступ .Тип у ОпределяемыйТип, метод .Типы()
                // у ОписаниеТипов и Метаданные.НайтиПоТипу()/ПолноеИмя() ниже подтверждены
                // офиц. документацией 1С и БСП, но не исходниками этого репозитория.
                ОписаниеТиповОбъекта = ОбъектМД.Тип;
                Для Каждого ТипЭлемента Из ОписаниеТиповОбъекта.Типы() Цикл
                    // Ссылочный тип -> техническое ПолноеИмя (напр. "Справочник.Пользователи"),
                    // нужное ИИ для кода и запросов. Для примитивов НайтиПоТипу возвращает
                    // Неопределено, поэтому берём Строка(Тип) (напр. "Число").
                    СоставТипов.Добавить(ПолноеИмяИлиСтрокаТипа(ТипЭлемента));
                КонецЦикла;
            Исключение
                // Защитный откат: Строка(<ОписаниеТипов>) подтверждён исходниками
                // (блоки реквизитов, измерений, ресурсов). Худший случай: пустой массив, не 500.
                Попытка
                    СоставТипов = Новый Массив;
                    СоставТипов.Добавить(Строка(ОбъектМД.Тип));
                Исключение
                КонецПопытки;
            КонецПопытки;
            Результат.Вставить("types", СоставТипов);
        КонецЕсли;

        // Структура подсистемы. Guard по ТипОбъекта. content = полные имена входящих
        // объектов (ОбъектМД.Состав), subsystems = дерево вложенных подсистем.
        Если ТипОбъекта = "Subsystem" Тогда
            // NEEDS REAL-1C VALIDATION: .Состав, .ПолноеИмя() у элементов состава и
            // вложенные .Подсистемы у подсистемы не подтверждены исходниками репозитория.
            // Всё защищено Попытка. Худший случай: пустые массивы, не 500.
            ПредупрежденияПодсистемы = Новый Массив;
            Состав = Новый Массив;
            Попытка
                Для Каждого ЭлементСостава Из ОбъектМД.Состав Цикл
                    Попытка
                        Состав.Добавить(ЭлементСостава.ПолноеИмя());
                    Исключение
                        ДобавитьПредупреждениеПодсистемы(ПредупрежденияПодсистемы, ОбъектМД, ОписаниеОшибки());
                    КонецПопытки;
                КонецЦикла;
            Исключение
                ДобавитьПредупреждениеПодсистемы(ПредупрежденияПодсистемы, ОбъектМД, ОписаниеОшибки());
            КонецПопытки;
            Результат.Вставить("content", Состав);

            ДочерниеПодсистемы = Новый Массив;
            Попытка
                Для Каждого ДочерняяПодсистема Из ОбъектМД.Подсистемы Цикл
                    ДочерниеПодсистемы.Добавить(ОписаниеПодсистемы(ДочерняяПодсистема, ПредупрежденияПодсистемы));
                КонецЦикла;
            Исключение
                ДобавитьПредупреждениеПодсистемы(ПредупрежденияПодсистемы, ОбъектМД, ОписаниеОшибки());
            КонецПопытки;
            Результат.Вставить("subsystems", ДочерниеПодсистемы);

            Если ПредупрежденияПодсистемы.Количество() > 0 Тогда
                Результат.Вставить("warnings", ПредупрежденияПодсистемы);
            КонецЕсли;
        КонецЕсли;

        Возврат ОтветJSON(Результат);
        // ── B leg end ──
    Иначе
        // ── C leg start ──
        Попытка
            МассивРасш = РасширенияКонфигурации.Получить(
                Новый Структура("Имя", ИмяРасш));
            Если МассивРасш = Неопределено ИЛИ МассивРасш.Количество() = 0 Тогда
                Возврат Ответ404Произвольный("Extension not found: " + ИмяРасш);
            КонецЕсли;
            Данные = МассивРасш[0].ПолучитьДанные();
            ОбёрткаМД = Новый ОбъектМетаданныхКонфигурация(Данные);

            ИмяКоллекции = "";
            Если      ТипОбъекта = "Catalog"                    Тогда ИмяКоллекции = "Справочники";
            ИначеЕсли ТипОбъекта = "Document"                   Тогда ИмяКоллекции = "Документы";
            ИначеЕсли ТипОбъекта = "Enum"                       Тогда ИмяКоллекции = "Перечисления";
            ИначеЕсли ТипОбъекта = "DataProcessor"              Тогда ИмяКоллекции = "Обработки";
            ИначеЕсли ТипОбъекта = "Report"                     Тогда ИмяКоллекции = "Отчеты";
            ИначеЕсли ТипОбъекта = "InformationRegister"        Тогда ИмяКоллекции = "РегистрыСведений";
            ИначеЕсли ТипОбъекта = "AccumulationRegister"       Тогда ИмяКоллекции = "РегистрыНакопления";
            ИначеЕсли ТипОбъекта = "AccountingRegister"         Тогда ИмяКоллекции = "РегистрыБухгалтерии";
            ИначеЕсли ТипОбъекта = "CalculationRegister"        Тогда ИмяКоллекции = "РегистрыРасчета";
            ИначеЕсли ТипОбъекта = "ChartOfAccounts"            Тогда ИмяКоллекции = "ПланыСчетов";
            ИначеЕсли ТипОбъекта = "ChartOfCharacteristicTypes" Тогда ИмяКоллекции = "ПланыВидовХарактеристик";
            ИначеЕсли ТипОбъекта = "ChartOfCalculationTypes"    Тогда ИмяКоллекции = "ПланыВидовРасчета";
            ИначеЕсли ТипОбъекта = "ExchangePlan"               Тогда ИмяКоллекции = "ПланыОбмена";
            ИначеЕсли ТипОбъекта = "BusinessProcess"            Тогда ИмяКоллекции = "БизнесПроцессы";
            ИначеЕсли ТипОбъекта = "Task"                       Тогда ИмяКоллекции = "Задачи";
            ИначеЕсли ТипОбъекта = "Constant"                   Тогда ИмяКоллекции = "Константы";
            Иначе    Возврат ОтветОшибка(400, "Unknown object type: " + ТипОбъекта);
            КонецЕсли;

            Коллекция = ОбёрткаМД[ИмяКоллекции];
            ОбъектМД = Коллекция.Найти(ИмяОбъекта);
            Если ОбъектМД = Неопределено Тогда
                Возврат Ответ404Произвольный(
                    "Object not in extension: " + ТипОбъекта + "." + ИмяОбъекта);
            КонецЕсли;
            Возврат ОтветJSON(СобратьСтруктуруОбъекта(ОбъектМД));
        Исключение
            Возврат Ответ501Произвольный(ОписаниеОшибки());
        КонецПопытки;
        // ── C leg end ──
    КонецЕсли;
КонецФункции

// POST /query
Функция ЗапросPOST(Запрос)
    Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

    ТекстЗапроса = Параметры.query;
    Лимит = 100;
    Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
        Лимит = Мин(Параметры.limit, 1000);
    КонецЕсли;

    Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, 10)));
    Если Лев(Префикс, 7) <> "ВЫБРАТЬ" И Лев(Префикс, 6) <> "SELECT" Тогда
        Возврат ОтветОшибка(400, "Only SELECT queries allowed");
    КонецЕсли;

    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);

        Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из Параметры.parameters Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;

        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        Возврат ОтветОшибка(400, ОписаниеОшибки());
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;

    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total", Счетчик);
    Результат.Вставить("truncated", Усечено);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /configuration
Функция КонфигурацияGET(Запрос)
    Результат = Новый Структура;
    Результат.Вставить("name",             Метаданные.Имя);
    Результат.Вставить("version",          Метаданные.Версия);
    Результат.Вставить("vendor",           Метаданные.Поставщик);
    СИ = Новый СистемнаяИнформация;
    Результат.Вставить("platform_version", СИ.ВерсияПриложения);

    РежимИБ = "";
    Попытка
        СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
        Если СтрНайти(ВРег(СтрокаСоединения), "FILE=") > 0 Тогда
            РежимИБ = "file";
        ИначеЕсли СтрНайти(ВРег(СтрокаСоединения), "SRVR=") > 0 Тогда
            РежимИБ = "server";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Результат.Вставить("mode", РежимИБ);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /version
Функция ВерсияGET(Запрос)
    Результат = Новый Структура;
    Результат.Вставить("version", "0.8.0");

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /form/{type}/{name}
//
// Dual-leg dispatch (v0.6.1): см. описание у МодульGET. B leg возвращает
// расширенную структуру формы (элементы/команды/обработчики), C leg по
// ?extension=<имя> читает текст модуля формы из wrapper API. В C leg
// требуется указать ?form=<ИмяФормы>, чтобы wrapper однозначно нашёл форму.
Функция ФормаGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];
    // ИмяФормы из query-param (?form=...) только для C leg; B leg использует
    // основную форму, как и в предыдущих версиях.
    ИмяФормы = "";
    Попытка
        Значение = Запрос.ПараметрыЗапроса["form"];
        Если Значение <> Неопределено Тогда
            ИмяФормы = Значение;
        КонецЕсли;
    Исключение
        ИмяФормы = "";
    КонецПопытки;
    ИмяРасш  = "";
    // ПараметрыЗапроса в 1С 8.5 — ни Структура (.Свойство падает), ни обычное
    // Соответствие ([отсутствующий-ключ] падает с «Поле объекта не обнаружено»).
    // Универсально оборачиваем в Попытка (live-1С тест 2026-05-22).
    Попытка
        Значение = Запрос.ПараметрыЗапроса["extension"];
        Если Значение <> Неопределено Тогда
            ИмяРасш = Значение;
        КонецЕсли;
    Исключение
        ИмяРасш = "";
    КонецПопытки;

    Если ПустаяСтрока(ИмяРасш) Тогда
        // ── B leg start ──
        ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
        Если ОбъектМД = Неопределено Тогда
            ИмяРасшНайдено = ОбъектПринадлежитРасширению(ТипОбъекта, ИмяОбъекта);
            Если НЕ ПустаяСтрока(ИмяРасшНайдено) Тогда
                Возврат Ответ501СExtensionOwner(ИмяРасшНайдено);
            КонецЕсли;
            Возврат ОтветОшибка(404, "Object not found");
        КонецЕсли;

        Форма = ПолучитьОсновнуюФорму(ОбъектМД);
        Если Форма = Неопределено Тогда
            Возврат ОтветОшибка(404, "Form not found");
        КонецЕсли;

        Результат = Новый Структура;
        Результат.Вставить("name", Форма.Имя);
        Результат.Вставить("title", Форма.Синоним);

        // Элементы формы (могут быть недоступны в режиме Предприятия)
        Элементы = Новый Массив;
        Попытка
            Для Каждого Элемент Из Форма.Элементы Цикл
                ОписаниеЭлемента = Новый Структура;
                ОписаниеЭлемента.Вставить("name", Элемент.Имя);
                ОписаниеЭлемента.Вставить("type", Строка(ТипЗнч(Элемент)));
                Попытка
                    ОписаниеЭлемента.Вставить("title", Элемент.Заголовок);
                Исключение
                    ОписаниеЭлемента.Вставить("title", "");
                КонецПопытки;
                Попытка
                    ОписаниеЭлемента.Вставить("dataPath", Строка(Элемент.ПутьКДанным));
                Исключение
                    ОписаниеЭлемента.Вставить("dataPath", "");
                КонецПопытки;
                Элементы.Добавить(ОписаниеЭлемента);
            КонецЦикла;
        Исключение
        КонецПопытки;
        Результат.Вставить("elements", Элементы);

        // Команды формы (могут быть недоступны в режиме Предприятия)
        Команды = Новый Массив;
        Попытка
            Для Каждого Команда Из Форма.Команды Цикл
                ОписаниеКоманды = Новый Структура;
                ОписаниеКоманды.Вставить("name", Команда.Имя);
                ОписаниеКоманды.Вставить("action", Команда.Действие);
                Команды.Добавить(ОписаниеКоманды);
            КонецЦикла;
        Исключение
        КонецПопытки;
        Результат.Вставить("commands", Команды);

        // Обработчики событий формы
        Обработчики = Новый Массив;
        МассивСобытий = Новый Массив;
        МассивСобытий.Добавить("ПриОткрытии");
        МассивСобытий.Добавить("ПриСозданииНаСервере");
        МассивСобытий.Добавить("ПередЗаписью");
        МассивСобытий.Добавить("ПриЗаписиНаСервере");
        МассивСобытий.Добавить("ПослеЗаписиНаСервере");
        МассивСобытий.Добавить("ПередЗакрытием");
        МассивСобытий.Добавить("ОбработкаОповещения");
        МассивСобытий.Добавить("ОбработкаНавигационнойСсылки");
        МассивСобытий.Добавить("ОбработкаВыбора");

        Для Каждого ИмяСобытия Из МассивСобытий Цикл
            Попытка
                ИмяОбработчика = Форма[ИмяСобытия];
                Если Не ПустаяСтрока(ИмяОбработчика) Тогда
                    ОписаниеОбработчика = Новый Структура;
                    ОписаниеОбработчика.Вставить("event", ИмяСобытия);
                    ОписаниеОбработчика.Вставить("handler", ИмяОбработчика);
                    Обработчики.Добавить(ОписаниеОбработчика);
                КонецЕсли;
            Исключение
                Продолжить;
            КонецПопытки;
        КонецЦикла;
        Результат.Вставить("handlers", Обработчики);

        Возврат ОтветJSON(Результат);
        // ── B leg end ──
    Иначе
        // ── C leg start ──
        Попытка
            МассивРасш = РасширенияКонфигурации.Получить(
                Новый Структура("Имя", ИмяРасш));
            Если МассивРасш = Неопределено ИЛИ МассивРасш.Количество() = 0 Тогда
                Возврат Ответ404Произвольный("Extension not found: " + ИмяРасш);
            КонецЕсли;
            Данные = МассивРасш[0].ПолучитьДанные();
            ОбёрткаМД = Новый ОбъектМетаданныхКонфигурация(Данные);

            ИмяКоллекции = "";
            Если      ТипОбъекта = "Catalog"                    Тогда ИмяКоллекции = "Справочники";
            ИначеЕсли ТипОбъекта = "Document"                   Тогда ИмяКоллекции = "Документы";
            ИначеЕсли ТипОбъекта = "DataProcessor"              Тогда ИмяКоллекции = "Обработки";
            ИначеЕсли ТипОбъекта = "Report"                     Тогда ИмяКоллекции = "Отчеты";
            ИначеЕсли ТипОбъекта = "InformationRegister"        Тогда ИмяКоллекции = "РегистрыСведений";
            ИначеЕсли ТипОбъекта = "AccumulationRegister"       Тогда ИмяКоллекции = "РегистрыНакопления";
            ИначеЕсли ТипОбъекта = "AccountingRegister"         Тогда ИмяКоллекции = "РегистрыБухгалтерии";
            Иначе    Возврат ОтветОшибка(400, "Unknown object type for forms: " + ТипОбъекта);
            КонецЕсли;

            Коллекция = ОбёрткаМД[ИмяКоллекции];
            ОбъектМД = Коллекция.Найти(ИмяОбъекта);
            Если ОбъектМД = Неопределено Тогда
                Возврат Ответ404Произвольный(
                    "Object not in extension: " + ТипОбъекта + "." + ИмяОбъекта);
            КонецЕсли;

            Если ПустаяСтрока(ИмяФормы) Тогда
                Возврат ОтветОшибка(400, "Form name required for C leg (use ?form=<ИмяФормы>)");
            КонецЕсли;
            Форма = ОбъектМД.Формы.Найти(ИмяФормы);
            Если Форма = Неопределено Тогда
                Возврат Ответ404Произвольный("Form not found in extension: " + ИмяФормы);
            КонецЕсли;
            Код = Форма.ПолучитьТекстМодуля();
            Если Код = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Код)) Тогда
                Возврат Ответ501Произвольный(
                    "wrapper API returned empty form module; method likely Конфигуратор-only.");
            КонецЕсли;
            Возврат ОтветJSON(Новый Структура(
                "code, source", Код, "extension:" + ИмяРасш));
        Исключение
            Возврат Ответ501Произвольный(ОписаниеОшибки());
        КонецПопытки;
        // ── C leg end ──
    КонецЕсли;
КонецФункции

// POST /validate-query
Функция ПроверкаЗапросаPOST(Запрос)
    Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

    ТекстЗапроса = Параметры.query;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required");
    КонецЕсли;

    Ошибки = Новый Массив;

    Попытка
        СхемаЗапроса = Новый СхемаЗапроса;
        СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
        СхемаЗапроса.ПолучитьТекстЗапроса();

        Результат = Новый Структура;
        Результат.Вставить("valid", Истина);
        Результат.Вставить("errors", Ошибки);
    Исключение
        Результат = Новый Структура;
        Результат.Вставить("valid", Ложь);
        Ошибки.Добавить(ОписаниеОшибки());
        Результат.Вставить("errors", Ошибки);
    КонецПопытки;

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /eventlog
Функция ЖурналРегистрацииPOST(Запрос)
    // ПРАВО ПРОВЕРЯЕТСЯ ДО ВСЕГО ОСТАЛЬНОГО. Без права Администрирование
    // ВыгрузитьЖурналРегистрации не возвращает ничего: оно бросает исключение, и
    // вызывающий получал 500 с именем модуля и номером строки в теле ответа. Это
    // тот же класс, что закрыт ниже для limit, и закрывается он так же.
    //
    // Отбор по пользователю такого вызывающего не спасал. НайтиПоИмени находит
    // СВОЁ СОБСТВЕННОЕ имя и без права, поэтому та ветка отвечает 403 только на
    // чужое имя, а вызов без отбора и вызов с отбором на самого себя доходили до
    // выгрузки и рвались.
    //
    // ЭТО ПРОВЕРКА, А НЕ Попытка, и разница тут несущая. Обёртка вокруг
    // ВыгрузитьЖурналРегистрации сделала бы неверными сразу два утверждения об
    // этом модуле: заметку о том, что исключение оттуда покидает обработчик, и
    // тест TestEventLogRightsFailureRaisesInsideTheExtension, который обходит эту
    // функцию и требует, чтобы вызов стоял ВНЕ любого Попытка. ПравоДоступа
    // задаёт вопрос: оно ничего не ловит и вызов никуда не двигает.
    //
    // Отказ не несёт ни одной записи и не несёт их количества. Частичный или
    // неотфильтрованный журнал под видом обычного ответа хуже отказа.
    Если НЕ ПравоДоступа("Администрирование", Метаданные) Тогда
        Возврат ОтветОшибка(403, "reading the event log requires the Администрирование right "
            + "and this account does not have it; no records are returned");
    КонецЕсли;

    // Тело читается один раз. ПУСТОЕ тело это законный вызов «журнал без отбора».
    // А тело, которое прислали и которое не разобралось, отбором не является:
    // раньше оно молча становилось пустой структурой, и журнал без единого отбора
    // выдавался за ответ на заданный вопрос.
    ТелоЗапроса = Запрос.ПолучитьТелоКакСтроку();

    Параметры = Новый Структура;
    Если ЗначениеЗаполнено(ТелоЗапроса) Тогда
        ОшибкаРазбора = "";
        Попытка
            Параметры = РазобратьJSON(ТелоЗапроса);
        Исключение
            ОшибкаРазбора = ОписаниеОшибки();
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаРазбора) Тогда
            Возврат ОтветОшибка(400, "request body is not valid JSON: " + ОшибкаРазбора);
        КонецЕсли;
        Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
            Возврат ОтветОшибка(400, "request body must be a JSON object");
        КонецЕсли;
    КонецЕсли;

    Отбор = Новый Структура;

    // Ниже действует одно правило: отбор, который применить нельзя, ОТКЛОНЯЕТСЯ,
    // а не отбрасывается. Молча отброшенный отбор давал ответ, побайтно равный
    // ответу на запрос вообще без отбора, и отличить их вызывающий не мог.

    Если Параметры.Свойство("start_date") И ЗначениеЗаполнено(Параметры.start_date) Тогда
        ДатаНачала = Неопределено;
        Попытка
            ДатаНачала = XMLЗначение(Тип("Дата"), Параметры.start_date);
        Исключение
        КонецПопытки;
        Если ДатаНачала = Неопределено Тогда
            Возврат ОтветОшибка(400, "start_date is not an ISO 8601 date (e.g. 2026-03-01T00:00:00): "
                + Строка(Параметры.start_date));
        КонецЕсли;
        Отбор.Вставить("ДатаНачала", ДатаНачала);
    КонецЕсли;

    Если Параметры.Свойство("end_date") И ЗначениеЗаполнено(Параметры.end_date) Тогда
        ДатаОкончания = Неопределено;
        Попытка
            ДатаОкончания = XMLЗначение(Тип("Дата"), Параметры.end_date);
        Исключение
        КонецПопытки;
        Если ДатаОкончания = Неопределено Тогда
            Возврат ОтветОшибка(400, "end_date is not an ISO 8601 date (e.g. 2026-03-07T23:59:59): "
                + Строка(Параметры.end_date));
        КонецЕсли;
        Отбор.Вставить("ДатаОкончания", ДатаОкончания);
    КонецЕсли;

    Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
        СоответствиеУровней = Новый Соответствие;
        СоответствиеУровней.Вставить("Ошибка",        УровеньЖурналаРегистрации.Ошибка);
        СоответствиеУровней.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
        СоответствиеУровней.Вставить("Информация",     УровеньЖурналаРегистрации.Информация);
        СоответствиеУровней.Вставить("Примечание",     УровеньЖурналаРегистрации.Примечание);
        Уровень = СоответствиеУровней[Параметры.level];
        Если Уровень = Неопределено Тогда
            Возврат ОтветОшибка(400, "unknown level: " + Строка(Параметры.level)
                + " (allowed: Ошибка, Предупреждение, Информация, Примечание)");
        КонецЕсли;
        МассивУровней = Новый Массив;
        МассивУровней.Добавить(Уровень);
        Отбор.Вставить("Уровень", МассивУровней);
    КонецЕсли;

    // ОТБОР ПО СОБЫТИЮ. Ключ Событие платформа принимает строкой или массивом
    // строк, и массив тут не роскошь: инцидент разбирают сразу по нескольким
    // событиям.
    //
    // ИМЯ, КОТОРОГО В БАЗЕ НЕТ, ОТКЛОНЯЕТСЯ, а не выбрасывается. Это то же
    // правило, которым живёт весь обработчик выше: отбор, который применить
    // нельзя, отклоняется. Выброшенное имя дало бы журнал, отобранный по всему
    // остальному, и total, посчитанный по нему же, а отличить такой ответ от
    // ответа на заданный вопрос вызывающий не может.
    //
    // СЛОВАРЬ ИМЁН БЕРЁТСЯ У САМОЙ БАЗЫ. ПолучитьЗначенияОтбораЖурналаРегистрации
    // отдаёт по ключу Событие соответствие: ключ это идентификатор события,
    // значение его представление. Из этого же списка выбирает окно журнала
    // регистрации, поэтому имени, которого в списке нет, окно и не предлагало.
    // Вызов стоит ВНУТРИ этой ветки, так что обычное чтение журнала за него не
    // платит.
    //
    // ИДЕНТИФИКАТОР НЕ РАВЕН ТОМУ, ЧТО ВИДНО В ОКНЕ. Окно показывает
    // ПредставлениеСобытия, «Сеанс. Начало», а отбор принимает идентификатор,
    // _$Session$_.Start. Поэтому отказ называет оба, а в ответе рядом с event
    // теперь едет event_presentation.
    Если Параметры.Свойство("event") Тогда
        ЗапрошенныеСобытия = Новый Массив;
        Если ТипЗнч(Параметры.event) = Тип("Строка") Тогда
            ЗапрошенныеСобытия.Добавить(Параметры.event);
        ИначеЕсли ТипЗнч(Параметры.event) = Тип("Массив") Тогда
            Для Каждого ЭлементОтбораСобытий Из Параметры.event Цикл
                ЗапрошенныеСобытия.Добавить(ЭлементОтбораСобытий);
            КонецЦикла;
        Иначе
            Возврат ОтветОшибка(400, "event must be an event name or an array of event names");
        КонецЕсли;

        Если ЗапрошенныеСобытия.Количество() = 0 Тогда
            Возврат ОтветОшибка(400, "event is empty; leave it out to read the log without an "
                + "event filter");
        КонецЕсли;

        ЗначенияСобытий = Неопределено;
        ОшибкаСловаряСобытий = "";
        Попытка
            ЗначенияСобытий = ПолучитьЗначенияОтбораЖурналаРегистрации("Событие").Событие;
        Исключение
            ОшибкаСловаряСобытий = ОписаниеОшибки();
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаСловаряСобытий) Тогда
            Возврат ОтветОшибка(403, "event filter cannot be resolved: " + ОшибкаСловаряСобытий);
        КонецЕсли;
        Если ТипЗнч(ЗначенияСобытий) <> Тип("Соответствие") Тогда
            Возврат ОтветОшибка(403, "event filter cannot be resolved: the base did not answer "
                + "the event value list as a map, so no name in event can be checked against it");
        КонецЕсли;

        МассивСобытийОтбора = Новый Массив;
        Для Каждого ИмяСобытия Из ЗапрошенныеСобытия Цикл
            Если ТипЗнч(ИмяСобытия) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ИмяСобытия) Тогда
                Возврат ОтветОшибка(400, "event must hold event names, and one of the values in "
                    + "it is not a name");
            КонецЕсли;
            Если ЗначенияСобытий.Получить(ИмяСобытия) = Неопределено Тогда
                Возврат ОтветОшибка(400, "unknown event: " + ИмяСобытия
                    + ". This base lists no event under that name. The name is a technical "
                    + "identifier such as _$Session$_.Start, not the phrase the 1С event log "
                    + "window shows; that phrase comes back in event_presentation");
            КонецЕсли;
            МассивСобытийОтбора.Добавить(ИмяСобытия);
        КонецЦикла;
        Отбор.Вставить("Событие", МассивСобытийОтбора);
    КонецЕсли;

    // У отбора по пользователю ДВА разных отказа, и раньше оба были неотличимы от
    // успеха. Имени нет в списке пользователей ИБ: значение выбрал вызывающий и он
    // может его исправить, поэтому 400. Сам поиск не состоялся: правкой значения
    // тут ничего не решить, поэтому 403. Это разные причины, и звать они должны в
    // разные места.
    //
    // ПРИЧИНА ЗДЕСЬ БОЛЬШЕ НЕ НАЗЫВАЕТСЯ. Текст говорил «скорее всего у учётной
    // записи нет права Администрирование», и верно это было ровно до проверки в
    // начале обработчика: сюда доходит только тот, у кого право есть, так что
    // названная причина стала единственной заведомо исключённой.
    Если Параметры.Свойство("user") И ЗначениеЗаполнено(Параметры.user) Тогда
        Если ТипЗнч(Параметры.user) <> Тип("Строка") Тогда
            Возврат ОтветОшибка(400, "user must be a string");
        КонецЕсли;
        ПользовательИБ = Неопределено;
        ОшибкаПоиска = "";
        Попытка
            ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Параметры.user);
        Исключение
            ОшибкаПоиска = ОписаниеОшибки();
        КонецПопытки;
        Если ЗначениеЗаполнено(ОшибкаПоиска) Тогда
            Возврат ОтветОшибка(403, "user filter cannot be resolved: " + ОшибкаПоиска);
        КонецЕсли;
        Если ПользовательИБ = Неопределено Тогда
            Возврат ОтветОшибка(400, "unknown infobase user: " + Параметры.user);
        КонецЕсли;
        МассивПользователей = Новый Массив;
        МассивПользователей.Добавить(ПользовательИБ);
        Отбор.Вставить("Пользователь", МассивПользователей);
    КонецЕсли;

    // limit это потолок выдачи, а не отбор: 0 и отрицательное значение означают
    // «сколько по умолчанию», ровно как clampLimit на стороне Go. А вот значение
    // НЕ ЧИСЛОВОГО типа доходило до сравнения и рвало обработчик, отдавая
    // вызывающему имя модуля и номер строки в теле ответа с кодом 500.
    Лимит = 50;
    Если Параметры.Свойство("limit") И ЗначениеЗаполнено(Параметры.limit) Тогда
        Если ТипЗнч(Параметры.limit) <> Тип("Число") Тогда
            Возврат ОтветОшибка(400, "limit must be a number");
        КонецЕсли;
        Если Параметры.limit > 0 Тогда
            Лимит = Мин(Параметры.limit, 500);
        КонецЕсли;
    КонецЕсли;

    // Защита от OOM: если не указана дата начала, ограничиваем последними 7 днями
    Если НЕ Отбор.Свойство("ДатаНачала") Тогда
        Отбор.Вставить("ДатаНачала", ТекущаяДата() - 7 * 86400);
    КонецЕсли;

    // ПЯТЫЙ АРГУМЕНТ ОГРАНИЧИВАЕТ ЧТЕНИЕ, А НЕ ВЫДАЧУ. Третий и четвёртый,
    // Колонки и ИмяВходногоФайла, пропущены нарочно: иначе до
    // МаксимальногоКоличества не добраться. Раньше вызов шёл с двумя
    // аргументами, платформа читала в таблицу все подходящие записи, а лимит
    // применялся уже после неё, поэтому запрос десяти записей обходился не
    // дешевле запроса всех.
    //
    // Граница в цикле ниже оставлена. Читает платформа, а обещание limit даёт
    // этот обработчик, и второму незачем зависеть от первого.
    ТаблицаЖурнала = Новый ТаблицаЗначений;
    ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор, , , Лимит);

    МассивСобытий = Новый Массив;
    Для Индекс = 0 По Мин(Лимит, ТаблицаЖурнала.Количество()) - 1 Цикл
        Строка = ТаблицаЖурнала[Индекс];
        Событие = Новый Структура;
        Событие.Вставить("date",        XMLСтрока(Строка.Дата));
        Событие.Вставить("level",       Строка(Строка.Уровень));
        Событие.Вставить("event",       Строка(Строка.Событие));
        Событие.Вставить("event_presentation", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ПредставлениеСобытия"));
        Событие.Вставить("user",        Строка(Строка.ИмяПользователя));
        Событие.Вставить("computer",    Строка(Строка.Компьютер));
        Событие.Вставить("metadata",    ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ПредставлениеМетаданных"));
        Событие.Вставить("data",        ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ПредставлениеДанных"));
        Событие.Вставить("comment",     ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "Комментарий"));
        Событие.Вставить("transaction", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "Транзакция"));
        МассивСобытий.Добавить(Событие);
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("events", МассивСобытий);
    // «total» считает записи ЭТОГО ответа, потому и берётся из массива, который
    // уезжает, а не из таблицы. Пока чтение было неограниченным, там стояло
    // число всех записей, подходящих под отбор в окне обработчика, и оно могло
    // быть больше выдачи. С ограниченным чтением такого числа больше нет: чтобы
    // его получить, надо снова прочитать всё, то есть вернуть ту самую цену,
    // ради снятия которой чтение и ограничили.
    Результат.Вставить("total",  МассивСобытий.Количество());

    Возврат ОтветJSON(Результат);
КонецФункции

Функция ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, ИмяКолонки)
    Если ТаблицаЖурнала.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Строка[ИмяКолонки]);
КонецФункции

// GET /extensions — возвращает бинарные данные (.cfe) всех расширений в base64
Функция РасширенияGET(Запрос)
    Результат = Новый Массив;

    Попытка
        МассивРасширений = РасширенияКонфигурации.Получить();
    Исключение
        Возврат ОтветJSON(Результат);
    КонецПопытки;

    Для Каждого Расширение Из МассивРасширений Цикл
        Попытка
            Данные = Расширение.ПолучитьДанные();
            ОписаниеРасш = Новый Структура;
            ОписаниеРасш.Вставить("name", Расширение.Имя);
            ОписаниеРасш.Вставить("data", Base64Строка(Данные));
            Результат.Добавить(ОписаниеРасш);
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /extensions-info - лёгкие метаданные расширений БЕЗ бинарного .cfe.
// Мета-аналог /extensions (мирроринг /configuration-info). НЕ вызывает
// ПолучитьДанные(): нет base64, нет большого пакета, ответ укладывается в
// общий лимит. Возвращает только свойства расширения на чтение; выполняется
// от имени вызывающего пользователя без привилегированного режима.
// Все шесть полей ниже - это СВОЙСТВА объекта РасширениеКонфигурации
// (Активно, Версия, БезопасныйРежим, ХешСумма, ОбластьДействия,
// УникальныйИдентификатор), поэтому читаются БЕЗ круглых скобок. Каждое
// чтение обёрнуто в Попытку: сбой строкового поля даёт "" и НЕ роняет строку
// расширения; сбой active пропускает ключ (см. ниже), а не подаёт Null.
Функция ИнформацияОРасширенияхGET(Запрос)
    Результат = Новый Массив;

    Попытка
        МассивРасширений = РасширенияКонфигурации.Получить();
    Исключение
        Возврат ОтветJSON(Результат);
    КонецПопытки;

    Для Каждого Расширение Из МассивРасширений Цикл
        ОписаниеРасш = Новый Структура;

        ИмяРасш = "";
        Попытка
            ИмяРасш = Расширение.Имя;
        Исключение
            ИмяРасш = "";
        КонецПопытки;
        ОписаниеРасш.Вставить("name", ИмяРасш);

        Попытка
            ОписаниеРасш.Вставить("active", Расширение.Активно);
        Исключение
            // Ключ active НЕ вставляем: Null на проводе, поданный в ЗаписатьJSON,
            // упал бы и обрушил весь ответ. Пропуск ключа декодируется
            // потребителем как tri-state "unknown", а не лживое "отключено".
        КонецПопытки;

        ВерсияРасш = "";
        Попытка
            ВерсияРасш = Строка(Расширение.Версия);
        Исключение
            ВерсияРасш = "";
        КонецПопытки;

        // ЗАПАСНОЙ ИСТОЧНИК ВЕРСИИ, И ТОЛЬКО ДЛЯ НАШЕГО СОБСТВЕННОГО РАСШИРЕНИЯ.
        //
        // Свойство РасширениеКонфигурации.Версия платформа берёт из элемента
        // <Version> в Configuration.xml, а вендорный установщик этот элемент
        // из выгрузки удаляет: функция stripInheritedProperties вызывается из
        // трёх мест, одно по версии платформы и два на повторной попытке. На
        // такой установке платформа возвращает пустую строку, и до этой правки
        // GET /extensions-info честно отдавал пустую версию нашего собственного
        // расширения.
        //
        // Литерал ниже лежит в ЭТОМ модуле, а модуль установщик не трогает:
        // удаляются элементы Configuration.xml, а не текст BSL. Тот же литерал
        // отдаёт ВерсияGET по маршруту GET /version, и оба закреплены одним
        // тестом (cmd/mcp-1c-advanced/version_test.go).
        //
        // ПОДСТАНОВКА ТОЛЬКО ПО СВОЕМУ ИМЕНИ. Про версию чужого расширения этот
        // модуль не знает ничего, и подставить туда своё число значило бы
        // соврать о чужом объекте. Имя сравнивается точно.
        //
        // ИСТОЧНИК НАЗВАН В ОТВЕТЕ. Ключ version_source отличает значение,
        // прочитанное у платформы, от подставленного модулем, чтобы потребитель
        // мог видеть разницу, а не догадываться о ней.
        ИсточникВерсии = "platform";
        Если ВерсияРасш = "" И ИмяРасш = "MCP_HTTPService" Тогда
            ВерсияРасш = "0.8.0";
            ИсточникВерсии = "module";
        КонецЕсли;
        ОписаниеРасш.Вставить("version", ВерсияРасш);
        ОписаниеРасш.Вставить("version_source", ИсточникВерсии);

        Попытка
            ОписаниеРасш.Вставить("safe_mode", Строка(Расширение.БезопасныйРежим));
        Исключение
            ОписаниеРасш.Вставить("safe_mode", "");
        КонецПопытки;

        Попытка
            ОписаниеРасш.Вставить("install_hash", Строка(Расширение.ХешСумма));
        Исключение
            ОписаниеРасш.Вставить("install_hash", "");
        КонецПопытки;

        Попытка
            ОписаниеРасш.Вставить("scope", Строка(Расширение.ОбластьДействия));
        Исключение
            ОписаниеРасш.Вставить("scope", "");
        КонецПопытки;

        Попытка
            ОписаниеРасш.Вставить("uuid", Строка(Расширение.УникальныйИдентификатор));
        Исключение
            ОписаниеРасш.Вставить("uuid", "");
        КонецПопытки;

        Результат.Добавить(ОписаниеРасш);
    КонецЦикла;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /configuration-info: расширенная информация для проверки совместимости платформы.
// Возвращает name/version/vendor/platform_version/mode. Поле compatibility_mode
// сознательно не возвращается. Его не консумит Go-клиент onec.ConfigurationInfo.
Функция ИнформацияОКонфигурацииGET(Запрос)
    // Делегирует КонфигурацияGET. /configuration-info добавлен в 0.5.0 для Go-клиента
    // (onec.ConfigurationInfo). Поле compatibility_mode сознательно не возвращается:
    // его не консумит Go-клиент.
    Возврат КонфигурацияGET(Запрос);
КонецФункции

// POST /execute: выполнение произвольного кода 1С.
// Request body: {"code": "<bsl>", "mode": "read_only"|"full"|"eval", "timeout": <seconds>}
// Response: {"result": "<string>", "error": "<string>", "duration_ms": <int>}
//
// Семантика mode (для совместимости с polling-реализацией):
//   "eval": вычислить выражение через Вычислить(), вернуть значение в result.
//   иначе:  выполнить как оператор через Выполнить(), result = "".
// Go-клиент шлёт "read_only" или "full" (см. sandbox.Mode). Оба значения попадают в ветку Выполнить.
Функция ВыполнениеPOST(Запрос)
    Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

    Если НЕ Параметры.Свойство("code") ИЛИ ПустаяСтрока(Параметры.code) Тогда
        Возврат ОтветОшибка(400, "code is required");
    КонецЕсли;

    КодДляВыполнения = Параметры.code;

    Режим = "exec";
    Если Параметры.Свойство("mode") Тогда
        Режим = НРег(Параметры.mode);
    КонецЕсли;

    НачалоВыполнения = ТекущаяУниверсальнаяДатаВМиллисекундах();

    Попытка
        Если Режим = "eval" Тогда
            РезультатВыполнения = Вычислить(КодДляВыполнения);
        Иначе
            Выполнить(КодДляВыполнения);
            Сообщения = ПолучитьСообщенияПользователю(Истина);
            СтрокиВывода = Новый Массив;
            Для Каждого М Из Сообщения Цикл
                СтрокиВывода.Добавить(М.Текст);
            КонецЦикла;
            РезультатВыполнения = СтрСоединить(СтрокиВывода, Символы.ПС);
        КонецЕсли;
    Исключение
        ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;
        Результат = Новый Структура;
        Результат.Вставить("result",      "");
        Результат.Вставить("error",       ОписаниеОшибки());
        Результат.Вставить("duration_ms", ДлительностьМс);
        Возврат ОтветJSON(Результат);
    КонецПопытки;

    ДлительностьМс = ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоВыполнения;

    Результат = Новый Структура;
    Результат.Вставить("result",      ПривестиЗначениеКJSON(РезультатВыполнения));
    Результат.Вставить("error",       "");
    Результат.Вставить("duration_ms", ДлительностьМс);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /module/{type}/{name}/{kind} и /module/{type}/{name}/{kind}/{form}
// Возвращает исходный код модуля объекта метаданных.
// Ответ: 200 {"code": "<текст модуля>"}; ошибки — {"error": "..."}.
//
// Dual-leg dispatch (v0.6.1):
//   B leg = default, ?extension= отсутствует, поиск только в основной
//           конфигурации. При промахе с extension-owned объектом отвечает
//           501 + X-Extension-Owner для transparent Go-side retry.
//   C leg = opt-in, ?extension=<имя> присутствует, прямое чтение через
//           wrapper API РасширенияКонфигурации.Получить -> ПолучитьДанные ->
//           ОбъектМетаданныхКонфигурация. Всё обёрнуто в Попытка/Исключение,
//           при любом сбое отвечает 501 c подсказкой extension_module.
Функция МодульGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];
    ВидМодуля  = Запрос.ПараметрыURL["kind"];
    // Сегмент {form} есть только у 5-сегментного шаблона; на 4-сегментном
    // шаблоне (без формы) обращение к отсутствующему ключу падает с
    // «Поле объекта не обнаружено» в 1С 8.5.x runtime (подтверждено live-1С
    // тестом 2026-05-22). Защищаемся Попыткой.
    ИмяФормы = "";
    Попытка
        ИмяФормы = Запрос.ПараметрыURL["form"];
        Если ИмяФормы = Неопределено Тогда
            ИмяФормы = "";
        КонецЕсли;
    Исключение
        ИмяФормы = "";
    КонецПопытки;
    ИмяРасш  = "";
    // ПараметрыЗапроса в 1С 8.5 — ни Структура (.Свойство падает), ни обычное
    // Соответствие ([отсутствующий-ключ] падает с «Поле объекта не обнаружено»).
    // Универсально оборачиваем в Попытка (live-1С тест 2026-05-22).
    Попытка
        Значение = Запрос.ПараметрыЗапроса["extension"];
        Если Значение <> Неопределено Тогда
            ИмяРасш = Значение;
        КонецЕсли;
    Исключение
        ИмяРасш = "";
    КонецПопытки;

    Если ПустаяСтрока(ИмяРасш) Тогда
        // ── B leg start ──
        ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
        Если ОбъектМД = Неопределено Тогда
            ИмяРасшНайдено = ОбъектПринадлежитРасширению(ТипОбъекта, ИмяОбъекта);
            Если НЕ ПустаяСтрока(ИмяРасшНайдено) Тогда
                Возврат Ответ501СExtensionOwner(ИмяРасшНайдено);
            КонецЕсли;
            Возврат Ответ404Произвольный("Object not found: " + ТипОбъекта + "." + ИмяОбъекта);
        КонецЕсли;

        // На 1С 8.5+ Метаданные.<Коллекция>.Найти возвращает unified view:
        // активное расширение делает свои объекты видимыми в основной коллекции.
        // ПолучитьТекстМодуля на таких extension-borrowed объектах не работает
        // (live-1С тест 2026-05-22), поэтому отвечаем 501 + X-Extension-Owner
        // и маршрутизируем клиента к Go-side extension_module fallback.
        Попытка
            РасшВладелец = ОбъектМД.РасширениеКонфигурации();
            Если РасшВладелец <> Неопределено Тогда
                Возврат Ответ501СExtensionOwner(РасшВладелец.Имя);
            КонецЕсли;
        Исключение
            // Если метод недоступен — продолжаем как обычно (B leg main path).
        КонецПопытки;

        // Маппинг английского вида модуля во внутреннее имя 1С.
        СоответствиеМодулей = Новый Соответствие;
        СоответствиеМодулей.Вставить("ObjectModule",       "МодульОбъекта");
        СоответствиеМодулей.Вставить("ManagerModule",      "МодульМенеджера");
        СоответствиеМодулей.Вставить("RecordSetModule",    "МодульНабораЗаписей");
        СоответствиеМодулей.Вставить("CommandModule",      "МодульКоманды");
        СоответствиеМодулей.Вставить("ValueManagerModule", "МодульМенеджераЗначения");
        СоответствиеМодулей.Вставить("FormModule",         "");  // обрабатывается отдельно

        Если ВРег(ВидМодуля) = ВРег("FormModule") Тогда
            Если НЕ ПустаяСтрока(ИмяФормы) Тогда
                Попытка
                    Форма = ОбъектМД.Формы.Найти(ИмяФормы);
                Исключение
                    // Защитно: у объекта без коллекции .Формы (Подсистема,
                    // ОпределяемыйТип, а также маркер-неоднозначности Структура)
                    // обращение к .Формы бросает исключение. Без этой Попытки оно
                    // выходило за пределы обработчика -> платформенный HTTP 500.
                    // Деградируем в 404, как сиблинг-доступы (ПолучитьОсновнуюФорму,
                    // путь ПолучитьТекстМодуля).
                    Возврат Ответ404Произвольный("Object has no forms: " + ТипОбъекта + "." + ИмяОбъекта);
                КонецПопытки;
                Если Форма = Неопределено Тогда
                    Возврат Ответ404Произвольный("Form not found: " + ИмяФормы);
                КонецЕсли;
            Иначе
                Форма = ПолучитьОсновнуюФорму(ОбъектМД);
                Если Форма = Неопределено Тогда
                    Возврат Ответ404Произвольный("Object has no forms: " + ТипОбъекта + "." + ИмяОбъекта);
                КонецЕсли;
            КонецЕсли;
            Попытка
                Код = Форма.ПолучитьТекстМодуля();
            Исключение
                Возврат ОтветОшибка(404, "Object has no FormModule module");
            КонецПопытки;
            Возврат ОтветJSON(Новый Структура("code", Код));
        КонецЕсли;

        ИмяМодуля1С = СоответствиеМодулей[ВидМодуля];
        Если ИмяМодуля1С = Неопределено Тогда
            // Неизвестный вид модуля — пользовательский ввод. ОтветОшибка
            // формирует JSON наивной конкатенацией без экранирования, поэтому
            // подставляем фиксированную формулировку, а не сырое значение:
            // тело ответа обязано остаться синтаксически валидным JSON при
            // любом ВидМодуля, включая значения с символами " и \.
            Возврат ОтветОшибка(400, "Unknown module kind");
        КонецЕсли;

        Попытка
            Код = ОбъектМД.ПолучитьТекстМодуля(ИмяМодуля1С);
        Исключение
            // Исключение = у объекта нет модуля этого вида -> 404.
            // Легитимно пустой модуль (ПолучитьТекстМодуля вернул "" без
            // исключения) обрабатывается ниже как 200 с {"code":""}.
            Возврат Ответ404Произвольный("Object has no " + ВидМодуля + " module");
        КонецПопытки;

        Возврат ОтветJSON(Новый Структура("code", Код));
        // ── B leg end ──
    Иначе
        // ── C leg start ──
        Попытка
            // NB: filter Structure shape ("Имя"=...) extrapolated from
            // стандартный 1С collection filter pattern. Точная сигнатура
            // РасширенияКонфигурации.Получить в paywalled its.1c.ru
            // syntax-assistant. Попытка/Исключение покрывает кейс "Не та
            // структура отбора" fallback'ом на bare .Получить() в catch.
            МассивРасш = РасширенияКонфигурации.Получить(
                Новый Структура("Имя", ИмяРасш));
            Если МассивРасш = Неопределено ИЛИ МассивРасш.Количество() = 0 Тогда
                Возврат Ответ404Произвольный("Extension not found: " + ИмяРасш);
            КонецЕсли;
            Данные = МассивРасш[0].ПолучитьДанные();
            ОбёрткаМД = Новый ОбъектМетаданныхКонфигурация(Данные);

            ИмяКоллекции = "";
            Если      ТипОбъекта = "Catalog"                    Тогда ИмяКоллекции = "Справочники";
            ИначеЕсли ТипОбъекта = "Document"                   Тогда ИмяКоллекции = "Документы";
            ИначеЕсли ТипОбъекта = "Enum"                       Тогда ИмяКоллекции = "Перечисления";
            ИначеЕсли ТипОбъекта = "DataProcessor"              Тогда ИмяКоллекции = "Обработки";
            ИначеЕсли ТипОбъекта = "Report"                     Тогда ИмяКоллекции = "Отчеты";
            ИначеЕсли ТипОбъекта = "InformationRegister"        Тогда ИмяКоллекции = "РегистрыСведений";
            ИначеЕсли ТипОбъекта = "AccumulationRegister"       Тогда ИмяКоллекции = "РегистрыНакопления";
            ИначеЕсли ТипОбъекта = "AccountingRegister"         Тогда ИмяКоллекции = "РегистрыБухгалтерии";
            ИначеЕсли ТипОбъекта = "CalculationRegister"        Тогда ИмяКоллекции = "РегистрыРасчета";
            ИначеЕсли ТипОбъекта = "ChartOfAccounts"            Тогда ИмяКоллекции = "ПланыСчетов";
            ИначеЕсли ТипОбъекта = "ChartOfCharacteristicTypes" Тогда ИмяКоллекции = "ПланыВидовХарактеристик";
            ИначеЕсли ТипОбъекта = "ChartOfCalculationTypes"    Тогда ИмяКоллекции = "ПланыВидовРасчета";
            ИначеЕсли ТипОбъекта = "ExchangePlan"               Тогда ИмяКоллекции = "ПланыОбмена";
            ИначеЕсли ТипОбъекта = "BusinessProcess"            Тогда ИмяКоллекции = "БизнесПроцессы";
            ИначеЕсли ТипОбъекта = "Task"                       Тогда ИмяКоллекции = "Задачи";
            ИначеЕсли ТипОбъекта = "Constant"                   Тогда ИмяКоллекции = "Константы";
            Иначе    Возврат ОтветОшибка(400, "Unknown object type: " + ТипОбъекта);
            КонецЕсли;

            Коллекция = ОбёрткаМД[ИмяКоллекции];
            ОбъектМД = Коллекция.Найти(ИмяОбъекта);
            Если ОбъектМД = Неопределено Тогда
                Возврат Ответ404Произвольный(
                    "Object not in extension: " + ТипОбъекта + "." + ИмяОбъекта);
            КонецЕсли;

            // FormModule в C ноге: зеркалит B-веточку выше — ищем форму у
            // объекта расширения и читаем её .ПолучитьТекстМодуля(). Без
            // ИмяФормы возвращаем 400, потому что в расширении часто живёт
            // несколько форм и понятия «основной» здесь как такового нет,
            // да и B-веточка тоже требует form_name для disambiguation.
            // ЭтотВариант для FormModule заходит в этот if до построения
            // СоответствиеМодулейC ниже, потому что соответствие хранит
            // лишь объектные модули; FormModule обрабатывается отдельно.
            Если ВРег(ВидМодуля) = ВРег("FormModule") Тогда
                Если ПустаяСтрока(ИмяФормы) Тогда
                    Возврат ОтветОшибка(400, "Form name required for FormModule in C leg (use ?form=<ИмяФормы>)");
                КонецЕсли;
                Форма = ОбъектМД.Формы.Найти(ИмяФормы);
                Если Форма = Неопределено Тогда
                    Возврат Ответ404Произвольный("Form not found in extension: " + ИмяФормы);
                КонецЕсли;
                Попытка
                    Код = Форма.ПолучитьТекстМодуля();
                Исключение
                    Возврат Ответ501Произвольный(ОписаниеОшибки());
                КонецПопытки;
                Если Код = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Код)) Тогда
                    Возврат Ответ501Произвольный(
                        "wrapper API returned empty form module; method likely Конфигуратор-only.");
                КонецЕсли;
                Возврат ОтветJSON(Новый Структура(
                    "code, source", Код, "extension:" + ИмяРасш));
            КонецЕсли;

            СоответствиеМодулейC = Новый Соответствие;
            СоответствиеМодулейC.Вставить("ObjectModule",       "МодульОбъекта");
            СоответствиеМодулейC.Вставить("ManagerModule",      "МодульМенеджера");
            СоответствиеМодулейC.Вставить("RecordSetModule",    "МодульНабораЗаписей");
            СоответствиеМодулейC.Вставить("CommandModule",      "МодульКоманды");
            СоответствиеМодулейC.Вставить("ValueManagerModule", "МодульМенеджераЗначения");

            ИмяМодуля1С = СоответствиеМодулейC[ВидМодуля];
            Если ИмяМодуля1С = Неопределено Тогда
                Возврат ОтветОшибка(400, "Unknown module kind for C leg: " + ВидМодуля);
            КонецЕсли;

            Код = ОбъектМД.ПолучитьТекстМодуля(ИмяМодуля1С);

            // FR-3-10: wrapper API может вернуть пусто или auto-stub.
            // Точное определение stub-комментария (regex) делает Go-сторона
            // при разборе тела, здесь же ловим только пустую/whitespace-only
            // строку: уже это достаточно для 501-фолбэка на extension_module.
            Если Код = Неопределено ИЛИ ПустаяСтрока(СокрЛП(Код)) Тогда
                Возврат Ответ501Произвольный(
                    "wrapper API returned empty module text; method likely Конфигуратор-only.");
            КонецЕсли;

            Возврат ОтветJSON(Новый Структура(
                "code, source", Код, "extension:" + ИмяРасш));
        Исключение
            Возврат Ответ501Произвольный(ОписаниеОшибки());
        КонецПопытки;
        // ── C leg end ──
    КонецЕсли;
КонецФункции
